{
  "name": "ExameOcupacional",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do exame (ex: Audiometria, Acuidade Visual)"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo interno do exame"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Cl\u00ednico",
        "Laboratorial",
        "Audiom\u00e9trico",
        "Oftalmol\u00f3gico",
        "Radiol\u00f3gico",
        "Psicol\u00f3gico",
        "Outro"
      ],
      "description": "Categoria do exame"
    },
    "descricao": {
      "type": "string"
    },
    "periodicidade_padrao_meses": {
      "type": "number",
      "description": "Periodicidade padr\u00e3o em meses"
    },
    "indicacoes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fun\u00e7\u00f5es/riscos para os quais este exame \u00e9 indicado"
    },
    "nr_referencia": {
      "type": "string",
      "description": "NR de refer\u00eancia (ex: NR-7)"
    },
    "preparo_necessario": {
      "type": "string",
      "description": "Instru\u00e7\u00f5es de preparo para o exame"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome",
    "categoria"
  ]
}