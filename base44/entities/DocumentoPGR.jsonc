{
  "name": "DocumentoPGR",
  "type": "object",
  "properties": {
    "empresa_nome": {
      "type": "string",
      "description": "Nome da empresa"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ da empresa"
    },
    "cnae": {
      "type": "string",
      "description": "C\u00f3digo CNAE da empresa"
    },
    "cnae_descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da atividade econ\u00f4mica (CNAE)"
    },
    "endereco": {
      "type": "string",
      "description": "Endere\u00e7o da empresa"
    },
    "responsavel_tecnico": {
      "type": "string",
      "description": "Nome do respons\u00e1vel t\u00e9cnico pelo PGR"
    },
    "registro_crea": {
      "type": "string",
      "description": "N\u00famero de registro no CREA"
    },
    "data_elaboracao": {
      "type": "string",
      "format": "date",
      "description": "Data de elabora\u00e7\u00e3o do documento"
    },
    "vigencia_inicio": {
      "type": "string",
      "format": "date",
      "description": "In\u00edcio da vig\u00eancia do PGR"
    },
    "vigencia_fim": {
      "type": "string",
      "format": "date",
      "description": "Fim da vig\u00eancia do PGR"
    },
    "numero_funcionarios": {
      "type": "number",
      "description": "N\u00famero de funcion\u00e1rios abrangidos"
    },
    "arquivo_pdf": {
      "type": "string",
      "description": "URL do arquivo PDF do PGR"
    },
    "status": {
      "type": "string",
      "enum": [
        "Rascunho",
        "Ativo",
        "Vencido",
        "Em Revis\u00e3o"
      ],
      "default": "Rascunho",
      "description": "Status do documento"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais sobre o documento"
    },
    "extraido_por_ia": {
      "type": "boolean",
      "default": false,
      "description": "Se os dados foram extra\u00eddos automaticamente por IA"
    },
    "data_upload": {
      "type": "string",
      "format": "date",
      "description": "Data em que o documento foi enviado"
    }
  },
  "required": []
}