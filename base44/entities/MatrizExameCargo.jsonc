{
  "name": "MatrizExameCargo",
  "type": "object",
  "properties": {
    "nome_cargo": {
      "type": "string",
      "description": "Nome do cargo (ex: Administrativo, Empilhadeirista, Eletricista)"
    },
    "cbo": {
      "type": "string",
      "description": "C\u00f3digo CBO do cargo"
    },
    "nr_aplicavel": {
      "type": "string",
      "description": "Norma Regulamentadora aplic\u00e1vel (ex: NR-35, NR-33, NR-10)"
    },
    "exames_obrigatorios": {
      "type": "string",
      "description": "Lista dos exames obrigat\u00f3rios separados por v\u00edrgula"
    },
    "periodicidade_meses": {
      "type": "number",
      "default": 12,
      "description": "Periodicidade de realiza\u00e7\u00e3o dos exames em meses"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais sobre os exames do cargo"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se a matriz est\u00e1 ativa"
    }
  },
  "required": [
    "nome_cargo"
  ]
}