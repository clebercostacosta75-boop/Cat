{
  "name": "Certificate",
  "type": "object",
  "properties": {
    "certificate_code": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico de valida\u00e7\u00e3o (ex: CAT-2025-XXXXXXXX)"
    },
    "internal_control_code": {
      "type": "string",
      "description": "C\u00f3digo interno \u00fanico de controle (independente do QR Code e do c\u00f3digo p\u00fablico)"
    },
    "certification_type": {
      "type": "string",
      "enum": [
        "Forma\u00e7\u00e3o",
        "Atualiza\u00e7\u00e3o",
        "Reciclagem"
      ],
      "description": "Tipo da certifica\u00e7\u00e3o: Forma\u00e7\u00e3o, Atualiza\u00e7\u00e3o ou Reciclagem"
    },
    "student_id": {
      "type": "string",
      "description": "ID do aluno vinculado (refer\u00eancia \u00e0 entidade Student)"
    },
    "student_name": {
      "type": "string",
      "description": "Nome completo do aluno"
    },
    "student_cpf": {
      "type": "string",
      "description": "CPF do aluno"
    },
    "student_email": {
      "type": "string",
      "description": "E-mail do aluno para envio de alertas"
    },
    "student_phone": {
      "type": "string",
      "description": "Telefone/WhatsApp do aluno"
    },
    "course_id": {
      "type": "string",
      "description": "ID do curso realizado (refer\u00eancia \u00e0 entidade Course)"
    },
    "course_name": {
      "type": "string",
      "description": "Nome do curso (ex: NR-35 \u2013 Trabalho em Altura)"
    },
    "course_duration": {
      "type": "string",
      "description": "Carga hor\u00e1ria (ex: 8h)"
    },
    "course_modality": {
      "type": "string",
      "description": "Modalidade do curso"
    },
    "programmatic_content": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module": {
            "type": "string"
          },
          "hours": {
            "type": "string"
          }
        }
      },
      "description": "Conte\u00fado program\u00e1tico"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Data de t\u00e9rmino"
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento do certificado"
    },
    "location_and_date": {
      "type": "string",
      "description": "Local e data de emiss\u00e3o"
    },
    "client_id": {
      "type": "string",
      "description": "ID do cliente/empresa"
    },
    "client_name": {
      "type": "string",
      "description": "Nome do cliente/empresa contratante"
    },
    "instructor_name": {
      "type": "string",
      "description": "Nome do instrutor"
    },
    "instructor_qualification": {
      "type": "string",
      "description": "Qualifica\u00e7\u00e3o/forma\u00e7\u00e3o do instrutor"
    },
    "technical_responsibles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "registration": {
            "type": "string"
          }
        }
      },
      "description": "Respons\u00e1veis t\u00e9cnicos"
    },
    "class_schedule_id": {
      "type": "string",
      "description": "ID da turma vinculada"
    },
    "enrollment_id": {
      "type": "string",
      "description": "ID da matr\u00edcula (StudentCourseEnrollment)"
    },
    "issue_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora de emiss\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_signature",
        "signed",
        "active",
        "revoked",
        "expired"
      ],
      "default": "pending_signature",
      "description": "Status do certificado"
    },
    "signature_url": {
      "type": "string",
      "description": "URL da assinatura digital do aluno"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da assinatura"
    },
    "signed_ip": {
      "type": "string",
      "description": "IP do dispositivo que assinou"
    },
    "signed_device": {
      "type": "string",
      "description": "User-agent do dispositivo"
    },
    "whatsapp_sent": {
      "type": "boolean",
      "default": false,
      "description": "Se o link foi enviado via WhatsApp"
    },
    "whatsapp_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do envio do WhatsApp"
    },
    "front_background_url": {
      "type": "string"
    },
    "back_background_url": {
      "type": "string"
    },
    "show_programmatic_hours": {
      "type": "boolean",
      "default": true
    },
    "revocation_reason": {
      "type": "string",
      "description": "Motivo obrigat\u00f3rio da revoga\u00e7\u00e3o"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da revoga\u00e7\u00e3o"
    },
    "revoked_by": {
      "type": "string",
      "description": "E-mail do respons\u00e1vel que revogou"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Vers\u00e3o do certificado (para reemiss\u00f5es)"
    },
    "reissued_from_id": {
      "type": "string",
      "description": "ID do certificado original em caso de reemiss\u00e3o"
    },
    "signature_link_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de expira\u00e7\u00e3o do link de assinatura (7 dias)"
    },
    "signature_reminder_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do reenvio autom\u00e1tico do link (48h)"
    },
    "recipient_type": {
      "type": "string",
      "enum": [
        "aluno",
        "empresa"
      ],
      "description": "Tipo de destinat\u00e1rio: aluno (prazo 30 dias) ou empresa (prazo 45 dias)"
    },
    "download_deadline": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora limite para download do certificado (definido manualmente pelo gestor)"
    },
    "is_blocked": {
      "type": "boolean",
      "default": false,
      "description": "Se o download do certificado est\u00e1 bloqueado (ativado automaticamente ap\u00f3s download_deadline ou expira\u00e7\u00e3o da validade)"
    },
    "downloaded_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que o certificado foi baixado (opcional)"
    },
    "certificate_model_id": {
      "type": "string",
      "description": "ID do modelo de certificado utilizado"
    },
    "certificate_model_name": {
      "type": "string",
      "description": "Nome do modelo de certificado"
    },
    "detran_registro": {
      "type": "string",
      "description": "N\u00ba Registro DETRAN/PA (opcional)"
    },
    "renach": {
      "type": "string",
      "description": "N\u00famero do RENACH (opcional)"
    },
    "categoria_cnh": {
      "type": "string",
      "description": "Categoria CNH (opcional)"
    }
  },
  "required": [
    "student_name",
    "student_cpf",
    "course_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.student_id": "{{user.student_id}}"
        },
        {
          "data.student_cpf": "{{user.cpf}}"
        },
        {
          "data.client_id": {
            "$in": "{{user.company_permissions.company_id}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}