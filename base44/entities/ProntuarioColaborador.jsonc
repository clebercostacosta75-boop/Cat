{
  "name": "ProntuarioColaborador",
  "type": "object",
  "properties": {
    "empresa_mestre_id": {
      "type": "string"
    },
    "empresa_mestre_nome": {
      "type": "string"
    },
    "colaborador_sst_id": {
      "type": "string"
    },
    "nome_completo": {
      "type": "string"
    },
    "cpf": {
      "type": "string"
    },
    "data_nascimento": {
      "type": "string",
      "format": "date"
    },
    "sexo": {
      "type": "string",
      "enum": [
        "Masculino",
        "Feminino",
        "Outro"
      ]
    },
    "cargo": {
      "type": "string"
    },
    "funcao": {
      "type": "string"
    },
    "setor": {
      "type": "string"
    },
    "data_admissao": {
      "type": "string",
      "format": "date"
    },
    "turno": {
      "type": "string"
    },
    "salario_base": {
      "type": "number"
    },
    "grau_instrucao": {
      "type": "string",
      "enum": [
        "Fundamental",
        "M\u00e9dio",
        "T\u00e9cnico",
        "Superior",
        "P\u00f3s-gradua\u00e7\u00e3o"
      ]
    },
    "deficiencia": {
      "type": "boolean",
      "default": false
    },
    "tipo_deficiencia": {
      "type": "string"
    },
    "foto": {
      "type": "string"
    },
    "observacoes_medicas": {
      "type": "string"
    },
    "restricoes_atividade": {
      "type": "string"
    },
    "historico_acidentes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Inativo",
        "Afastado",
        "F\u00e9rias",
        "Demitido"
      ],
      "default": "Ativo"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "data.empresa_mestre_id": {
            "$in": "{{user.company_permissions.company_id}}"
          }
        },
        {
          "data.colaborador_sst_id": {
            "$in": "{{user.colaborador_sst_ids}}"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "data.empresa_mestre_id": {
            "$in": "{{user.company_permissions.company_id}}"
          }
        },
        {
          "data.colaborador_sst_id": {
            "$in": "{{user.colaborador_sst_ids}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}