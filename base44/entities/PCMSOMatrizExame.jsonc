{
  "name": "PCMSOMatrizExame",
  "type": "object",
  "properties": {
    "pcmso_detalhe_id": {
      "type": "string"
    },
    "funcao": {
      "type": "string"
    },
    "setor": {
      "type": "string"
    },
    "ghe": {
      "type": "string"
    },
    "riscos_ocupacionais": {
      "type": "string"
    },
    "exames_obrigatorios": {
      "type": "string"
    },
    "periodicidade": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "data.pcmso_detalhe_id": {
            "$in": "{{user.pcmso_detalhe_ids}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}