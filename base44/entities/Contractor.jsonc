{
  "name": "Contractor",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Nome da empresa contratada"
    },
    "razao_social": {
      "type": "string",
      "description": "Raz\u00e3o Social"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ da contratada"
    },
    "logo_url": {
      "type": "string",
      "description": "URL do logo da empresa contratada"
    },
    "address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string",
          "description": "Logradouro"
        },
        "number": {
          "type": "string",
          "description": "N\u00famero"
        },
        "complement": {
          "type": "string",
          "description": "Complemento"
        },
        "neighborhood": {
          "type": "string",
          "description": "Bairro"
        },
        "city": {
          "type": "string",
          "description": "Cidade"
        },
        "state": {
          "type": "string",
          "description": "Estado"
        },
        "zip_code": {
          "type": "string",
          "description": "CEP"
        }
      }
    },
    "bank_data": {
      "type": "object",
      "properties": {
        "bank_name": {
          "type": "string",
          "description": "Nome do Banco"
        },
        "bank_code": {
          "type": "string",
          "description": "C\u00f3digo do Banco"
        },
        "agency": {
          "type": "string",
          "description": "Ag\u00eancia com d\u00edgito"
        },
        "account": {
          "type": "string",
          "description": "Conta com d\u00edgito"
        },
        "account_type": {
          "type": "string",
          "enum": [
            "Corrente",
            "Poupan\u00e7a"
          ],
          "description": "Tipo da conta"
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "contract_number": {
            "type": "string",
            "description": "N\u00famero do contrato"
          },
          "client_company_id": {
            "type": "string",
            "description": "ID da empresa cliente (Company)"
          },
          "client_company_name": {
            "type": "string",
            "description": "Nome da empresa cliente"
          },
          "contract_object": {
            "type": "string",
            "description": "Objeto do contrato"
          },
          "contract_value": {
            "type": "number",
            "description": "Valor total do contrato"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "Data de in\u00edcio do contrato"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "Data de t\u00e9rmino do contrato"
          },
          "bmm_reference": {
            "type": "string",
            "description": "Refer\u00eancia para o BMM"
          },
          "status": {
            "type": "string",
            "enum": [
              "Ativo",
              "Encerrado",
              "Suspenso"
            ],
            "default": "Ativo",
            "description": "Status do contrato"
          }
        }
      },
      "description": "Contratos com empresas clientes"
    },
    "contact_email": {
      "type": "string",
      "format": "email",
      "description": "E-mail de contato"
    },
    "contact_phone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Inativo"
      ],
      "default": "Ativo",
      "description": "Status da contratada"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais"
    }
  },
  "required": [
    "company_name",
    "razao_social",
    "cnpj"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}