{
  "name": "PGRTreinamentoFuncao",
  "type": "object",
  "properties": {
    "pgr_leitura_id": {
      "type": "string"
    },
    "funcao": {
      "type": "string"
    },
    "nr_aplicavel": {
      "type": "string"
    },
    "treinamento_obrigatorio": {
      "type": "string"
    },
    "carga_horaria": {
      "type": "number"
    },
    "validade_meses": {
      "type": "number"
    },
    "status_colaborador": {
      "type": "string",
      "enum": [
        "Treinado",
        "Pendente",
        "Vencendo",
        "Vencido"
      ],
      "default": "Pendente"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "data.pgr_leitura_id": {
            "$in": "{{user.pgr_leitura_ids}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}