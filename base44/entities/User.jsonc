{
  "name": "User",
  "type": "object",
  "properties": {
    "custom_role": {
      "type": "string",
      "enum": [
        "Administrador Master",
        "Coordenador de Opera\u00e7\u00f5es",
        "Financeiro",
        "Instrutor",
        "Certifica\u00e7\u00e3o",
        "Atendimento",
        "PortalEmpresa"
      ],
      "description": "N\u00edvel de acesso personalizado do usu\u00e1rio"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Permiss\u00f5es espec\u00edficas para funcionalidades do dashboard"
    },
    "phone": {
      "type": "string",
      "description": "Telefone/WhatsApp do usu\u00e1rio"
    },
    "is_whatsapp": {
      "type": "boolean",
      "default": false,
      "description": "Indica se o telefone \u00e9 WhatsApp"
    }
  },
  "required": [
    "custom_role",
    "permissions",
    "phone"
  ]
}