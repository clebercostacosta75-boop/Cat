{
  "name": "User",
  "type": "object",
  "properties": {
    "custom_role": {
      "type": "string",
      "enum": [
        "Administrador Master",
        "Administrador",
        "Comercial",
        "Coordenador de Opera\u00e7\u00f5es",
        "Financeiro",
        "Instrutor",
        "Certifica\u00e7\u00e3o",
        "Atendimento",
        "Auditor",
        "PortalEmpresa"
      ],
      "description": "Papel legado mantido apenas para compatibilidade; UserProfile.role \u00e9 a fonte can\u00f4nica"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Espelho t\u00e9cnico de UserProfile.permissions para compatibilidade e RLS"
    },
    "phone": {
      "type": "string"
    },
    "is_whatsapp": {
      "type": "boolean",
      "default": false
    },
    "student_id": {
      "type": "string",
      "description": "V\u00ednculo RLS com Student"
    },
    "cpf": {
      "type": "string",
      "description": "CPF normalizado para regras RLS do pr\u00f3prio titular"
    },
    "instructor_id": {
      "type": "string",
      "description": "V\u00ednculo RLS com Instructor"
    },
    "company_permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "company_id": {
            "type": "string"
          },
          "company_name": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Espelho t\u00e9cnico de UserProfile.company_permissions para RLS"
    },
    "colaborador_sst_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pgr_leitura_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ltcat_detalhe_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}