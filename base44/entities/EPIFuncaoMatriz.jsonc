{
  "name": "EPIFuncaoMatriz",
  "type": "object",
  "properties": {
    "empresa_mestre_id": {
      "type": "string"
    },
    "empresa_mestre_nome": {
      "type": "string"
    },
    "pgr_leitura_id": {
      "type": "string"
    },
    "funcao": {
      "type": "string"
    },
    "setor": {
      "type": "string"
    },
    "atividade": {
      "type": "string"
    },
    "risco_identificado": {
      "type": "string"
    },
    "epi_cadastro_id": {
      "type": "string"
    },
    "epi_nome": {
      "type": "string"
    },
    "epi_ca": {
      "type": "string"
    },
    "periodicidade_troca_meses": {
      "type": "number"
    },
    "treinamento_necessario": {
      "type": "string"
    },
    "exame_relacionado": {
      "type": "string"
    },
    "responsavel_validacao": {
      "type": "string"
    }
  },
  "required": [
    "funcao"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "data.empresa_mestre_id": {
            "$in": "{{user.company_permissions.company_id}}"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "data.empresa_mestre_id": {
            "$in": "{{user.company_permissions.company_id}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}