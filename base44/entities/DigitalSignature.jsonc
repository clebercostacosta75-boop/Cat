{
  "name": "DigitalSignature",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do respons\u00e1vel (ex: Dr. Carlos Eduardo Lima)"
    },
    "title": {
      "type": "string",
      "description": "Cargo/T\u00edtulo (ex: T\u00e9cnico em Seguran\u00e7a do Trabalho)"
    },
    "registration": {
      "type": "string",
      "description": "N\u00famero de registro profissional (ex: CREA 123456/PA)"
    },
    "signature_url": {
      "type": "string",
      "description": "URL da imagem da assinatura (PNG transparente)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se a assinatura est\u00e1 ativa para uso"
    }
  },
  "required": [
    "name",
    "title"
  ]
}