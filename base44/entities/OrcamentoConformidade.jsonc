{
  "name": "OrcamentoConformidade",
  "type": "object",
  "properties": {
    "empresa_mestre_id": {
      "type": "string"
    },
    "empresa_mestre_nome": {
      "type": "string"
    },
    "ano_referencia": {
      "type": "number"
    },
    "orcamento_total": {
      "type": "number"
    },
    "orcamento_pgr": {
      "type": "number"
    },
    "orcamento_pcmso": {
      "type": "number"
    },
    "orcamento_ltcat": {
      "type": "number"
    },
    "orcamento_exames": {
      "type": "number"
    },
    "orcamento_epi": {
      "type": "number"
    },
    "orcamento_treinamentos": {
      "type": "number"
    },
    "orcamento_outros": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Rascunho",
        "Aprovado",
        "Em Execu\u00e7\u00e3o",
        "Encerrado"
      ],
      "default": "Rascunho"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empresa_mestre_id",
    "ano_referencia"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "user_condition": {
            "role": "Financeiro"
          }
        },
        {
          "data.empresa_mestre_id": {
            "$in": "{{user.company_permissions.company_id}}"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "user_condition": {
            "role": "Financeiro"
          }
        },
        {
          "data.empresa_mestre_id": {
            "$in": "{{user.company_permissions.company_id}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "user_condition": {
            "role": "Financeiro"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}