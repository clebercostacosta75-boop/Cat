{
  "name": "AccessAccount",
  "type": "object",
  "properties": {
    "access_type": {
      "type": "string",
      "enum": [
        "usuario_cat",
        "aluno",
        "empresa",
        "instrutor",
        "contratada"
      ]
    },
    "person_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "cpf": {
      "type": "string"
    },
    "cnpj": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_profile_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "instructor_id": {
      "type": "string"
    },
    "contractor_id": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "allowed_modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_portal": {
      "type": "string",
      "enum": [
        "interno",
        "aluno",
        "empresa",
        "instrutor",
        "contratada"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "aguardando_ativacao",
        "ativo",
        "bloqueado",
        "inativo",
        "link_expirado",
        "acesso_revogado"
      ],
      "default": "aguardando_ativacao"
    },
    "token_hash": {
      "type": "string"
    },
    "token_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "token_used_at": {
      "type": "string",
      "format": "date-time"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_access_at": {
      "type": "string",
      "format": "date-time"
    },
    "terms_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_email": {
      "type": "string"
    },
    "last_invite_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_status_changed_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "access_type",
    "person_name",
    "email",
    "allowed_portal",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}