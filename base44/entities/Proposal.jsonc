{
  "name": "Proposal",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "Processando",
        "Aguardando Revis\u00e3o",
        "Revisado",
        "Finalizado",
        "Erro"
      ],
      "default": "Processando",
      "description": "Status da proposta"
    },
    "file_url": {
      "type": "string",
      "description": "URL do PDF da proposta"
    },
    "file_name": {
      "type": "string",
      "description": "Nome do arquivo original"
    },
    "company_name": {
      "type": "string",
      "description": "Nome da empresa extra\u00eddo pela IA"
    },
    "company_cnpj": {
      "type": "string",
      "description": "CNPJ extra\u00eddo pela IA"
    },
    "company_id": {
      "type": "string",
      "description": "ID da empresa vinculada no sistema"
    },
    "courses": {
      "type": "array",
      "description": "Lista de cursos extra\u00eddos da proposta",
      "items": {
        "type": "object",
        "properties": {
          "course_name": {
            "type": "string"
          },
          "workload_hours": {
            "type": "number"
          },
          "students_count": {
            "type": "number"
          },
          "unit_value": {
            "type": "number"
          },
          "total_value": {
            "type": "number"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          },
          "location": {
            "type": "string"
          },
          "instructor_name": {
            "type": "string"
          },
          "modality": {
            "type": "string"
          }
        }
      }
    },
    "total_value": {
      "type": "number",
      "description": "Valor total da proposta"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    },
    "ai_raw_extraction": {
      "type": "string",
      "description": "Dados brutos extra\u00eddos pela IA (JSON string)"
    },
    "class_schedule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs das turmas criadas a partir desta proposta"
    }
  },
  "required": [
    "file_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}