{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "ID do lead vinculado"
    },
    "lead_name": {
      "type": "string",
      "description": "Nome do lead (desnormalizado)"
    },
    "channel": {
      "type": "string",
      "enum": [
        "Instagram",
        "Facebook",
        "WhatsApp",
        "LinkedIn",
        "TikTok",
        "Site",
        "E-mail",
        "Telefone",
        "Outro"
      ],
      "description": "Canal da conversa"
    },
    "social_account_id": {
      "type": "string",
      "description": "ID da conta social vinculada (refer\u00eancia \u00e0 SocialAccount)"
    },
    "social_account_name": {
      "type": "string",
      "description": "Nome amig\u00e1vel da conta social (ex: @catcursos_oficial)"
    },
    "external_conversation_id": {
      "type": "string",
      "description": "ID da conversa na plataforma externa (ex: thread_id do Instagram)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aberta",
        "Em Atendimento IA",
        "Aguardando Humano",
        "Em Atendimento Humano",
        "Resolvida",
        "Encerrada"
      ],
      "default": "Aberta",
      "description": "Status da conversa"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "human_agent"
            ],
            "description": "Quem enviou a mensagem"
          },
          "content": {
            "type": "string",
            "description": "Conte\u00fado da mensagem"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Data/hora da mensagem"
          },
          "media_url": {
            "type": "string",
            "description": "URL de m\u00eddia anexada (imagem, \u00e1udio, etc.)"
          },
          "media_type": {
            "type": "string",
            "description": "Tipo da m\u00eddia (image, audio, video, document)"
          }
        }
      },
      "description": "Hist\u00f3rico completo de mensagens da conversa"
    },
    "assigned_to": {
      "type": "string",
      "description": "E-mail do atendente humano respons\u00e1vel"
    },
    "assigned_to_name": {
      "type": "string",
      "description": "Nome do atendente humano"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da \u00faltima mensagem"
    },
    "last_message_preview": {
      "type": "string",
      "description": "Pr\u00e9via da \u00faltima mensagem"
    },
    "unread_count": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero de mensagens n\u00e3o lidas"
    },
    "ai_context": {
      "type": "string",
      "description": "Contexto acumulado da conversa para a IA (JSON string)"
    },
    "notes": {
      "type": "string",
      "description": "Notas internas do atendente"
    }
  },
  "required": [
    "channel",
    "lead_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.assigned_to": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.assigned_to": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}