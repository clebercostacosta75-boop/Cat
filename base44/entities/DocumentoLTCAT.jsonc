{
  "name": "DocumentoLTCAT",
  "type": "object",
  "properties": {
    "empresa_nome": {
      "type": "string",
      "description": "Nome da empresa"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ da empresa"
    },
    "responsavel_tecnico": {
      "type": "string",
      "description": "Nome do respons\u00e1vel t\u00e9cnico"
    },
    "registro_profissional": {
      "type": "string",
      "description": "N\u00famero CREA/CRO/CFT do respons\u00e1vel"
    },
    "data_elaboracao": {
      "type": "string",
      "format": "date",
      "description": "Data de elabora\u00e7\u00e3o"
    },
    "vigencia_inicio": {
      "type": "string",
      "format": "date",
      "description": "In\u00edcio da vig\u00eancia"
    },
    "vigencia_fim": {
      "type": "string",
      "format": "date",
      "description": "Fim da vig\u00eancia"
    },
    "arquivo_pdf": {
      "type": "string",
      "description": "URL do arquivo PDF"
    },
    "status": {
      "type": "string",
      "enum": [
        "Rascunho",
        "Ativo",
        "Vencido",
        "Em Revis\u00e3o"
      ],
      "default": "Rascunho"
    },
    "observacoes": {
      "type": "string"
    },
    "extraido_por_ia": {
      "type": "boolean",
      "default": false
    },
    "data_upload": {
      "type": "string",
      "format": "date"
    }
  },
  "required": []
}