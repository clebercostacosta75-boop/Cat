{
  "name": "LogNotificacoes",
  "type": "object",
  "properties": {
    "aluno_nome": {
      "type": "string",
      "description": "Nome do aluno"
    },
    "aluno_email": {
      "type": "string",
      "description": "E-mail do aluno"
    },
    "empresa_nome": {
      "type": "string",
      "description": "Nome da empresa"
    },
    "curso_nome": {
      "type": "string",
      "description": "Nome do curso"
    },
    "certificado_id": {
      "type": "string",
      "description": "ID do certificado"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "email",
        "whatsapp",
        "sms"
      ],
      "description": "Canal de envio"
    },
    "evento": {
      "type": "string",
      "enum": [
        "30dias",
        "15dias",
        "5dias",
        "assinatura",
        "confirmacao_agendamento"
      ],
      "description": "Tipo de evento que gerou a notifica\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "enviado",
        "erro"
      ],
      "default": "enviado",
      "description": "Status do envio"
    },
    "data_envio": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora do envio"
    },
    "mensagem_erro": {
      "type": "string",
      "description": "Detalhe do erro, se houver"
    }
  },
  "required": [
    "tipo",
    "evento",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.aluno_id": "{{user.student_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}