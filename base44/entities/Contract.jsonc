{
  "name": "Contract",
  "type": "object",
  "properties": {
    "contract_number": {
      "type": "string",
      "description": "N\u00famero \u00fanico do contrato (ex: CAT-2026-0001)"
    },
    "template_id": {
      "type": "string",
      "description": "ID do modelo de contrato utilizado"
    },
    "template_name": {
      "type": "string",
      "description": "Nome do modelo"
    },
    "proposal_id": {
      "type": "string",
      "description": "ID da proposta que originou este contrato (quando gerado via proposta aprovada)"
    },
    "student_id": {
      "type": "string",
      "description": "ID do aluno (ou ID da empresa em contratos de proposta B2B)"
    },
    "student_name": {
      "type": "string",
      "description": "Nome do aluno (ou raz\u00e3o social da empresa em contratos de proposta B2B)"
    },
    "student_cpf": {
      "type": "string",
      "description": "CPF do aluno (ou CNPJ da empresa em contratos de proposta B2B)"
    },
    "student_email": {
      "type": "string",
      "description": "E-mail do aluno"
    },
    "student_phone": {
      "type": "string",
      "description": "WhatsApp do aluno"
    },
    "student_data_nascimento": {
      "type": "string",
      "description": "Data de nascimento do aluno"
    },
    "is_minor": {
      "type": "boolean",
      "default": false,
      "description": "Se o aluno \u00e9 menor de idade"
    },
    "enrollment_id": {
      "type": "string",
      "description": "ID da matr\u00edcula vinculada"
    },
    "course_name": {
      "type": "string",
      "description": "Nome do curso"
    },
    "course_duration": {
      "type": "string",
      "description": "Carga hor\u00e1ria do curso"
    },
    "course_value": {
      "type": "number",
      "description": "Valor do curso"
    },
    "course_value_sem_desconto": {
      "type": "number",
      "description": "Valor do curso sem desconto"
    },
    "desconto_percentual": {
      "type": "number",
      "description": "Percentual de desconto"
    },
    "valor_entrada": {
      "type": "number",
      "description": "Valor de entrada"
    },
    "num_parcelas": {
      "type": "number",
      "description": "N\u00famero de parcelas"
    },
    "valor_parcela": {
      "type": "number",
      "description": "Valor da parcela"
    },
    "primeiro_vencimento": {
      "type": "string",
      "format": "date",
      "description": "Data do primeiro vencimento"
    },
    "payment_method": {
      "type": "string",
      "description": "Forma de pagamento"
    },
    "course_start_date": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio do curso"
    },
    "course_end_date": {
      "type": "string",
      "format": "date",
      "description": "Data de t\u00e9rmino do curso"
    },
    "status": {
      "type": "string",
      "enum": [
        "Rascunho",
        "Gerado_Automaticamente",
        "Gerado_Manualmente",
        "Enviado_Assinatura",
        "Aguardando_Assinatura_Aluno",
        "Aguardando_Assinatura_Responsavel_Legal",
        "Aguardando_Assinatura_Responsavel_Financeiro",
        "Aguardando_Assinatura_CAT",
        "Assinado_Parcialmente",
        "Assinado_Todas_Partes",
        "PDF_Gerado",
        "Enviado_WhatsApp",
        "Cancelado",
        "Substituido_Aditivo",
        "Expirado",
        "Recusado"
      ],
      "default": "Rascunho",
      "description": "Status do contrato"
    },
    "html_content_filled": {
      "type": "string",
      "description": "HTML do contrato com as vari\u00e1veis j\u00e1 preenchidas"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL do PDF gerado do contrato assinado"
    },
    "auth_code": {
      "type": "string",
      "description": "C\u00f3digo de autentica\u00e7\u00e3o \u00fanico do contrato"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do envio para assinatura"
    },
    "sent_via": {
      "type": "string",
      "enum": [
        "whatsapp",
        "email",
        "manual"
      ],
      "description": "Canal de envio"
    },
    "student_signed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da assinatura do aluno"
    },
    "student_signature_url": {
      "type": "string",
      "description": "URL da imagem da assinatura digital do aluno"
    },
    "student_signed_ip": {
      "type": "string",
      "description": "IP do dispositivo do aluno ao assinar"
    },
    "student_signed_device": {
      "type": "string",
      "description": "User-agent do dispositivo do aluno"
    },
    "student_lgpd_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do aceite da LGPD pelo aluno"
    },
    "resp_legal_nome": {
      "type": "string",
      "description": "Nome do respons\u00e1vel legal (menor de idade)"
    },
    "resp_legal_cpf": {
      "type": "string",
      "description": "CPF do respons\u00e1vel legal"
    },
    "resp_legal_phone": {
      "type": "string",
      "description": "WhatsApp do respons\u00e1vel legal"
    },
    "resp_legal_signed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da assinatura do respons\u00e1vel legal"
    },
    "resp_legal_signature_url": {
      "type": "string",
      "description": "URL da assinatura do respons\u00e1vel legal"
    },
    "resp_legal_signed_ip": {
      "type": "string",
      "description": "IP do respons\u00e1vel legal ao assinar"
    },
    "resp_financeiro_nome": {
      "type": "string",
      "description": "Nome do respons\u00e1vel financeiro"
    },
    "resp_financeiro_cpf": {
      "type": "string",
      "description": "CPF do respons\u00e1vel financeiro"
    },
    "resp_financeiro_phone": {
      "type": "string",
      "description": "WhatsApp do respons\u00e1vel financeiro"
    },
    "resp_financeiro_signed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da assinatura do respons\u00e1vel financeiro"
    },
    "resp_financeiro_signature_url": {
      "type": "string",
      "description": "URL da assinatura do respons\u00e1vel financeiro"
    },
    "resp_financeiro_signed_ip": {
      "type": "string",
      "description": "IP do respons\u00e1vel financeiro ao assinar"
    },
    "manager_signed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da assinatura do gestor CAT"
    },
    "manager_signed_by": {
      "type": "string",
      "description": "E-mail do gestor que assinou pela CAT"
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "description": "Data de validade do contrato"
    },
    "renewal_alert_sent": {
      "type": "boolean",
      "default": false,
      "description": "Se o alerta de renova\u00e7\u00e3o j\u00e1 foi enviado"
    },
    "whatsapp_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do envio do PDF assinado por WhatsApp"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "student_id",
    "student_name",
    "student_cpf"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.student_id": "{{user.student_id}}"
        },
        {
          "data.student_cpf": "{{user.cpf}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.student_id": "{{user.student_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}