{
  "name": "PGREPIFuncao",
  "type": "object",
  "properties": {
    "pgr_leitura_id": {
      "type": "string"
    },
    "funcao": {
      "type": "string"
    },
    "risco_associado": {
      "type": "string"
    },
    "epi_obrigatorio": {
      "type": "string"
    },
    "certificado_aprovacao_ca": {
      "type": "string"
    },
    "status_epi": {
      "type": "string",
      "enum": [
        "Entregue",
        "Pendente",
        "Vencido"
      ],
      "default": "Pendente"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "data.pgr_leitura_id": {
            "$in": "{{user.pgr_leitura_ids}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}