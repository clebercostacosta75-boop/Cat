{
  "name": "MatrizTreinamento",
  "type": "object",
  "properties": {
    "funcao_id": {
      "type": "string",
      "description": "ID da fun\u00e7\u00e3o/cargo"
    },
    "funcao_nome": {
      "type": "string",
      "description": "Nome da fun\u00e7\u00e3o"
    },
    "nr_id": {
      "type": "string",
      "description": "ID da NR vinculada"
    },
    "nr_codigo": {
      "type": "string",
      "description": "C\u00f3digo da NR (ex: NR-35)"
    },
    "curso_id": {
      "type": "string",
      "description": "ID do curso obrigat\u00f3rio (refer\u00eancia Course)"
    },
    "curso_nome": {
      "type": "string",
      "description": "Nome do curso obrigat\u00f3rio"
    },
    "carga_horaria": {
      "type": "number",
      "description": "Carga hor\u00e1ria exigida"
    },
    "periodicidade_meses": {
      "type": "number",
      "description": "Periodicidade da reciclagem em meses"
    },
    "modalidade": {
      "type": "string",
      "enum": [
        "Forma\u00e7\u00e3o",
        "Peri\u00f3dico",
        "Eventual"
      ],
      "description": "Modalidade do treinamento (forma\u00e7\u00e3o inicial, reciclagem peri\u00f3dica ou eventual)"
    },
    "obrigatorio": {
      "type": "boolean",
      "default": true,
      "description": "Se o treinamento \u00e9 obrigat\u00f3rio para a fun\u00e7\u00e3o"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (se matriz espec\u00edfica por empresa)"
    },
    "empresa_nome": {
      "type": "string",
      "description": "Nome da empresa"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "funcao_nome",
    "nr_codigo",
    "curso_nome"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Operacional"
          }
        },
        {
          "user_condition": {
            "role": "Certificacao"
          }
        },
        {
          "user_condition": {
            "role": "PortalEmpresa"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}