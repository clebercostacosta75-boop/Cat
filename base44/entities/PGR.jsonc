{
  "name": "PGR",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do PGR"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "empresa_nome": {
      "type": "string",
      "description": "Nome da empresa"
    },
    "unidade": {
      "type": "string",
      "description": "Unidade/filial"
    },
    "responsavel_tecnico": {
      "type": "string",
      "description": "Nome do respons\u00e1vel t\u00e9cnico"
    },
    "crea_cau": {
      "type": "string",
      "description": "N\u00famero CREA/CAU do respons\u00e1vel"
    },
    "data_elaboracao": {
      "type": "string",
      "format": "date",
      "description": "Data de elabora\u00e7\u00e3o"
    },
    "data_revisao": {
      "type": "string",
      "format": "date",
      "description": "Data da pr\u00f3xima revis\u00e3o"
    },
    "data_validade": {
      "type": "string",
      "format": "date",
      "description": "Data de validade"
    },
    "versao": {
      "type": "string",
      "description": "Vers\u00e3o do documento (ex: 1.0, 2.1)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Elabora\u00e7\u00e3o",
        "Em Vigor",
        "Em Revis\u00e3o",
        "Vencido",
        "Cancelado"
      ],
      "default": "Elabora\u00e7\u00e3o"
    },
    "grau_risco": {
      "type": "number",
      "minimum": 1,
      "maximum": 4,
      "description": "Grau de risco da empresa (1-4)"
    },
    "riscos_identificados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "F\u00edsico",
              "Qu\u00edmico",
              "Biol\u00f3gico",
              "Ergon\u00f4mico",
              "Acidente"
            ]
          },
          "descricao": {
            "type": "string"
          },
          "setor": {
            "type": "string"
          },
          "nivel": {
            "type": "string",
            "enum": [
              "Trivial",
              "Toler\u00e1vel",
              "Moderado",
              "Substancial",
              "Intoler\u00e1vel"
            ]
          },
          "medida_controle": {
            "type": "string"
          }
        }
      },
      "description": "Riscos identificados no invent\u00e1rio"
    },
    "plano_acao": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "acao": {
            "type": "string"
          },
          "responsavel": {
            "type": "string"
          },
          "prazo": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "Pendente",
              "Em Andamento",
              "Conclu\u00eddo",
              "Cancelado"
            ],
            "default": "Pendente"
          }
        }
      }
    },
    "documentos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "data_upload": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "titulo",
    "empresa_nome"
  ]
}