{
  "name": "CustoConformidade",
  "type": "object",
  "properties": {
    "empresa_mestre_id": {
      "type": "string"
    },
    "empresa_mestre_nome": {
      "type": "string"
    },
    "orcamento_conformidade_id": {
      "type": "string"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "PGR",
        "PCMSO",
        "LTCAT",
        "Exame M\u00e9dico",
        "EPI",
        "Treinamento",
        "Outro"
      ]
    },
    "subcategoria": {
      "type": "string"
    },
    "fornecedor": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "quantidade": {
      "type": "number"
    },
    "valor_unitario": {
      "type": "number"
    },
    "valor_total": {
      "type": "number"
    },
    "data_competencia": {
      "type": "string",
      "format": "date"
    },
    "data_vencimento_pagamento": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Or\u00e7ado",
        "Proposta Recebida",
        "Aprovado",
        "Pago",
        "Cancelado"
      ],
      "default": "Or\u00e7ado"
    },
    "nota_fiscal": {
      "type": "string"
    },
    "arquivo_proposta": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    },
    "nr_relacionada": {
      "type": "string"
    },
    "documento_relacionado": {
      "type": "string"
    },
    "aprovado_por": {
      "type": "string"
    },
    "aprovado_em": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "user_condition": {
            "role": "Financeiro"
          }
        },
        {
          "data.empresa_mestre_id": {
            "$in": "{{user.company_permissions.company_id}}"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "user_condition": {
            "role": "Financeiro"
          }
        },
        {
          "data.empresa_mestre_id": {
            "$in": "{{user.company_permissions.company_id}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "user_condition": {
            "role": "Financeiro"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}