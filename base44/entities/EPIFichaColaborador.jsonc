{
  "name": "EPIFichaColaborador",
  "type": "object",
  "properties": {
    "colaborador_sst_id": {
      "type": "string"
    },
    "empresa_mestre_id": {
      "type": "string"
    },
    "empresa_mestre_nome": {
      "type": "string"
    },
    "nome_colaborador": {
      "type": "string"
    },
    "cpf": {
      "type": "string"
    },
    "matricula": {
      "type": "string"
    },
    "cargo": {
      "type": "string"
    },
    "funcao": {
      "type": "string"
    },
    "setor": {
      "type": "string"
    },
    "total_epis_entregues": {
      "type": "number",
      "default": 0
    },
    "total_epis_pendentes": {
      "type": "number",
      "default": 0
    },
    "total_epis_vencidos": {
      "type": "number",
      "default": 0
    },
    "status_geral": {
      "type": "string",
      "enum": [
        "Em Dia",
        "Pendente",
        "Vencido"
      ],
      "default": "Pendente"
    },
    "ultima_atualizacao": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "data.empresa_mestre_id": {
            "$in": "{{user.company_permissions.company_id}}"
          }
        },
        {
          "data.colaborador_sst_id": {
            "$in": "{{user.colaborador_sst_ids}}"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "data.empresa_mestre_id": {
            "$in": "{{user.company_permissions.company_id}}"
          }
        },
        {
          "data.colaborador_sst_id": {
            "$in": "{{user.colaborador_sst_ids}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}