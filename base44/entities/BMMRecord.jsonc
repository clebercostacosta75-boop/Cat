{
  "name": "BMMRecord",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "company_name": {
      "type": "string",
      "description": "Nome da empresa"
    },
    "period": {
      "type": "string",
      "description": "Per\u00edodo do BMM (ex: Janeiro/2025)"
    },
    "template_id": {
      "type": "string",
      "description": "ID do modelo utilizado"
    },
    "template_name": {
      "type": "string",
      "description": "Nome do modelo utilizado"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL do PDF gerado"
    },
    "status": {
      "type": "string",
      "enum": [
        "Rascunho",
        "Pendente",
        "Aprovado",
        "Rejeitado",
        "Gerado",
        "Enviado",
        "Confirmado"
      ],
      "default": "Rascunho",
      "description": "Status do BMM"
    },
    "sent_to": {
      "type": "string",
      "description": "E-mail para o qual foi enviado"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do envio"
    },
    "total_value": {
      "type": "number",
      "description": "Valor total do BMM"
    },
    "total_classes": {
      "type": "number",
      "description": "Total de turmas no per\u00edodo"
    },
    "total_students": {
      "type": "number",
      "description": "Total de alunos no per\u00edodo"
    },
    "content_snapshot": {
      "type": "string",
      "description": "Snapshot do conte\u00fado HTML do BMM gerado"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Motivo da rejei\u00e7\u00e3o (quando status = Rejeitado)"
    },
    "approved_by": {
      "type": "string",
      "description": "Email do gestor que aprovou"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da aprova\u00e7\u00e3o"
    },
    "history": {
      "type": "array",
      "description": "Hist\u00f3rico de a\u00e7\u00f5es realizadas no BMM",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "Tipo de a\u00e7\u00e3o (Gerado, Enviado, Aprovado, Rejeitado, Pendente, Atualizado)"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Data e hora da a\u00e7\u00e3o"
          },
          "user_email": {
            "type": "string",
            "description": "E-mail do usu\u00e1rio que realizou a a\u00e7\u00e3o"
          },
          "details": {
            "type": "string",
            "description": "Detalhes adicionais da a\u00e7\u00e3o"
          }
        },
        "required": [
          "action",
          "timestamp"
        ]
      }
    }
  },
  "required": [
    "company_id",
    "company_name",
    "period"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.company_id": "{{user.data.company_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.company_id": "{{user.data.company_id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}