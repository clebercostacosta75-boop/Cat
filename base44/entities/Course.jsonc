{
  "name": "Course",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome oficial do curso"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do curso"
    },
    "validity": {
      "type": "string",
      "description": "Validade do treinamento (Ex: 12 meses, 24 meses)"
    },
    "carga_horaria": {
      "type": "string",
      "description": "Carga hor\u00e1ria do curso (ex: 8h)"
    },
    "modalidade": {
      "type": "string",
      "enum": [
        "Presencial",
        "Online",
        "H\u00edbrido"
      ],
      "description": "Modalidade padr\u00e3o do curso"
    },
    "categoria": {
      "type": "string",
      "description": "Categoria do curso (ex: Norma Regulamentadora, DETRAN)"
    },
    "conteudo_programatico": {
      "type": "string",
      "description": "Conte\u00fado program\u00e1tico (texto livre)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Inativo"
      ],
      "default": "Ativo",
      "description": "Status do curso"
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o"
    },
    "schedules": {
      "type": "object",
      "properties": {
        "morning": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "description": "Hor\u00e1rio de entrada manh\u00e3 (Ex: 07:00)"
            },
            "end": {
              "type": "string",
              "description": "Hor\u00e1rio de sa\u00edda manh\u00e3 (Ex: 11:00)"
            }
          }
        },
        "afternoon": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "description": "Hor\u00e1rio de entrada tarde (Ex: 13:00)"
            },
            "end": {
              "type": "string",
              "description": "Hor\u00e1rio de sa\u00edda tarde (Ex: 17:00)"
            }
          }
        },
        "night": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "description": "Hor\u00e1rio de entrada noturno (Ex: 19:00)"
            },
            "end": {
              "type": "string",
              "description": "Hor\u00e1rio de sa\u00edda noturno (Ex: 23:00)"
            }
          }
        }
      },
      "description": "Hor\u00e1rios padr\u00e3o estruturados por turno"
    }
  },
  "required": [
    "name"
  ]
}