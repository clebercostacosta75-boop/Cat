{
  "name": "ContaBancaria",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome amig\u00e1vel (ex: Caixa Geral, Bradesco PJ)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Caixa",
        "Conta Corrente",
        "Conta Poupan\u00e7a",
        "Conta de Investimento",
        "Cart\u00e3o de Cr\u00e9dito",
        "Cart\u00e3o de D\u00e9bito"
      ]
    },
    "banco": {
      "type": "string"
    },
    "agencia": {
      "type": "string"
    },
    "numero_conta": {
      "type": "string"
    },
    "digito": {
      "type": "string"
    },
    "cnpj_cpf_titular": {
      "type": "string"
    },
    "titular": {
      "type": "string"
    },
    "saldo_inicial": {
      "type": "number",
      "default": 0
    },
    "saldo_atual": {
      "type": "number",
      "default": 0
    },
    "data_saldo_inicial": {
      "type": "string",
      "format": "date"
    },
    "chave_pix": {
      "type": "string"
    },
    "tipo_chave_pix": {
      "type": "string",
      "enum": [
        "CPF",
        "CNPJ",
        "E-mail",
        "Telefone",
        "Chave Aleat\u00f3ria"
      ]
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome",
    "tipo"
  ]
}