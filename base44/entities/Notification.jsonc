{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio destinat\u00e1rio"
    },
    "type": {
      "type": "string",
      "enum": [
        "course_expiring",
        "class_slots_limited",
        "new_message",
        "class_scheduled",
        "payment_pending",
        "document_expiring"
      ],
      "description": "Tipo de notifica\u00e7\u00e3o"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo da notifica\u00e7\u00e3o"
    },
    "message": {
      "type": "string",
      "description": "Mensagem detalhada"
    },
    "link": {
      "type": "string",
      "description": "Link para a p\u00e1gina relacionada"
    },
    "related_entity": {
      "type": "string",
      "description": "Nome da entidade relacionada"
    },
    "related_entity_id": {
      "type": "string",
      "description": "ID da entidade relacionada"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Se a notifica\u00e7\u00e3o foi lida"
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da leitura"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "description": "Prioridade da notifica\u00e7\u00e3o"
    }
  },
  "required": [
    "user_id",
    "type",
    "title",
    "message"
  ]
}