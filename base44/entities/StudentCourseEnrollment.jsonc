{
  "name": "StudentCourseEnrollment",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "ID do aluno (refer\u00eancia \u00e0 entidade Student)"
    },
    "student_name": {
      "type": "string",
      "description": "Nome do aluno (desnormalizado para consultas)"
    },
    "student_cpf": {
      "type": "string",
      "description": "CPF do aluno"
    },
    "student_email": {
      "type": "string",
      "description": "E-mail do aluno"
    },
    "student_phone": {
      "type": "string",
      "description": "WhatsApp do aluno"
    },
    "course_id": {
      "type": "string",
      "description": "ID do curso (refer\u00eancia \u00e0 entidade Course)"
    },
    "course_name": {
      "type": "string",
      "description": "Nome do curso (desnormalizado)"
    },
    "course_duration": {
      "type": "string",
      "description": "Carga hor\u00e1ria do curso (ex: 8h)"
    },
    "certification_type": {
      "type": "string",
      "enum": [
        "Forma\u00e7\u00e3o",
        "Atualiza\u00e7\u00e3o",
        "Reciclagem"
      ],
      "default": "Forma\u00e7\u00e3o",
      "description": "Tipo da certifica\u00e7\u00e3o: Forma\u00e7\u00e3o, Atualiza\u00e7\u00e3o ou Reciclagem"
    },
    "validity_months": {
      "type": "number",
      "description": "Validade em meses (vinda do modelo de certificado ou curso)"
    },
    "company_id": {
      "type": "string",
      "description": "ID da empresa contratante (refer\u00eancia \u00e0 entidade Company)"
    },
    "company_name": {
      "type": "string",
      "description": "Nome da empresa contratante"
    },
    "instructor_id": {
      "type": "string",
      "description": "ID do instrutor respons\u00e1vel"
    },
    "instructor_name": {
      "type": "string",
      "description": "Nome do instrutor respons\u00e1vel"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio do curso"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Data de t\u00e9rmino do curso"
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento calculada automaticamente (end_date + validity_months)"
    },
    "certificate_model_id": {
      "type": "string",
      "description": "ID do modelo de certificado utilizado"
    },
    "certificate_model_name": {
      "type": "string",
      "description": "Nome do modelo de certificado"
    },
    "certificate_id": {
      "type": "string",
      "description": "ID do certificado gerado (ap\u00f3s autoriza\u00e7\u00e3o)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aguardando Autoriza\u00e7\u00e3o",
        "Autorizado",
        "Certificado Gerado",
        "Assinado",
        "Vencido",
        "Revogado"
      ],
      "default": "Aguardando Autoriza\u00e7\u00e3o",
      "description": "Status da matr\u00edcula/certificado"
    },
    "status_matricula": {
      "type": "string",
      "enum": [
        "Matriculado",
        "Em Andamento",
        "Conclu\u00eddo",
        "Cancelado"
      ],
      "default": "Matriculado",
      "description": "Ciclo acad\u00eamico da matr\u00edcula (SPR-A) \u2014 independente do ciclo de certificado"
    },
    "resultado_academico": {
      "type": "string",
      "enum": [
        "Pendente",
        "Aprovado",
        "Reprovado",
        "N\u00e3o Concluiu"
      ],
      "default": "Pendente",
      "description": "Resultado acad\u00eamico oficial (SPR-A) \u2014 definido na Gest\u00e3o Acad\u00eamica. Somente Aprovado permite certifica\u00e7\u00e3o"
    },
    "data_resultado": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que o resultado acad\u00eamico foi definido"
    },
    "responsavel_resultado": {
      "type": "string",
      "description": "Nome/e-mail de quem definiu o resultado acad\u00eamico"
    },
    "observacao_resultado": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o/justificativa do resultado acad\u00eamico"
    },
    "apto_certificacao": {
      "type": "boolean",
      "default": false,
      "description": "Se a matr\u00edcula est\u00e1 apta para certifica\u00e7\u00e3o (aprovado + sem pend\u00eancias bloqueantes)"
    },
    "data_apto_certificacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que a matr\u00edcula ficou apta para certifica\u00e7\u00e3o"
    },
    "bloqueio_certificacao": {
      "type": "boolean",
      "default": false,
      "description": "Bloqueio manual de certifica\u00e7\u00e3o (impede emiss\u00e3o mesmo aprovado)"
    },
    "motivo_bloqueio_certificacao": {
      "type": "string",
      "description": "Motivo do bloqueio manual de certifica\u00e7\u00e3o"
    },
    "liberacao_financeira_manual": {
      "type": "boolean",
      "default": false,
      "description": "SPR-2A: libera\u00e7\u00e3o financeira manual aprovada pelo Financeiro (permite certifica\u00e7\u00e3o mesmo sem pagamento quitado)"
    },
    "liberacao_financeira_por": {
      "type": "string",
      "description": "SPR-2A: e-mail do respons\u00e1vel do Financeiro que aprovou a libera\u00e7\u00e3o manual"
    },
    "liberacao_financeira_em": {
      "type": "string",
      "format": "date-time",
      "description": "SPR-2A: data/hora da libera\u00e7\u00e3o financeira manual"
    },
    "liberacao_financeira_justificativa": {
      "type": "string",
      "description": "SPR-2A: justificativa obrigat\u00f3ria da libera\u00e7\u00e3o financeira manual"
    },
    "authorized_by": {
      "type": "string",
      "description": "E-mail do respons\u00e1vel que autorizou"
    },
    "authorized_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da autoriza\u00e7\u00e3o"
    },
    "class_schedule_id": {
      "type": "string",
      "description": "ID da turma vinculada (opcional)"
    },
    "oferta_id": {
      "type": "string",
      "description": "FASE 1 Vendas: ID da oferta para comunidade (CourseOffer) que originou a matr\u00edcula (legado \u2014 mantido sincronizado com course_offer_id)"
    },
    "oferta_nome": {
      "type": "string",
      "description": "FASE 1 Vendas: nome comercial da oferta"
    },
    "pacote_id": {
      "type": "string",
      "description": "FASE 1 Vendas: ID do pacote (CoursePackage) que originou a matr\u00edcula"
    },
    "pacote_nome": {
      "type": "string",
      "description": "FASE 1 Vendas: nome do pacote"
    },
    "valor_original": {
      "type": "number",
      "description": "FASE 1 Vendas: valor original antes de desconto"
    },
    "desconto": {
      "type": "number",
      "default": 0,
      "description": "FASE 1 Vendas: desconto aplicado (R$)"
    },
    "parcelas_quantidade": {
      "type": "number",
      "default": 1,
      "description": "FASE 1 Vendas: quantidade de parcelas"
    },
    "atendente_id": {
      "type": "string",
      "description": "FASE 1 Vendas: ID do atendente respons\u00e1vel pela inscri\u00e7\u00e3o"
    },
    "atendente_nome": {
      "type": "string",
      "description": "FASE 1 Vendas: nome do atendente respons\u00e1vel"
    },
    "data_inscricao": {
      "type": "string",
      "format": "date-time",
      "description": "FASE 1 Vendas: data/hora da inscri\u00e7\u00e3o"
    },
    "origem_inscricao": {
      "type": "string",
      "enum": [
        "Presencial",
        "WhatsApp",
        "Telefone",
        "Indica\u00e7\u00e3o",
        "QR Code",
        "QR Code do Atendente",
        "Instagram",
        "Facebook",
        "Site",
        "Outro"
      ],
      "description": "FASE 1/2/3 Vendas: origem da inscri\u00e7\u00e3o"
    },
    "pre_cadastro_id": {
      "type": "string",
      "description": "FASE 2: ID do pr\u00e9-cadastro (PreCadastro) que originou a matr\u00edcula"
    },
    "unit_value": {
      "type": "number",
      "description": "Valor do curso para este aluno individual (PF)"
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "\u00c0 Vista",
        "Parcelado 2x",
        "Parcelado 3x",
        "Parcelado 4x",
        "Parcelado 5x",
        "Parcelado 6x",
        "Boleto",
        "Pix",
        "Cart\u00e3o de Cr\u00e9dito",
        "Cart\u00e3o de D\u00e9bito",
        "Transfer\u00eancia Banc\u00e1ria",
        "Dinheiro",
        "Dinheiro em Esp\u00e9cie",
        "Cortesia"
      ],
      "description": "Forma de pagamento do curso"
    },
    "status_pagamento": {
      "type": "string",
      "enum": [
        "Pendente",
        "Pago",
        "Parcialmente Pago",
        "Inadimplente",
        "Aguardando Confirma\u00e7\u00e3o",
        "Cancelado",
        "Cortesia"
      ],
      "default": "Pendente",
      "description": "Status do pagamento"
    },
    "data_vencimento_pagamento": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento do pagamento"
    },
    "observacao_financeira": {
      "type": "string",
      "description": "FASE 1 Vendas: observa\u00e7\u00e3o financeira da inscri\u00e7\u00e3o"
    },
    "workflow_stage": {
      "type": "string",
      "enum": [
        "Draft",
        "DocumentsPending",
        "PaymentPending",
        "ContractPending",
        "Confirmed",
        "InProgress",
        "Completed",
        "Cancelled",
        "Transferred",
        "Suspended",
        "Refunded"
      ],
      "description": "Central de Matr\u00edcula: etapa operacional unificada do fluxo (novo \u2014 coexiste com status/status_matricula legados)"
    },
    "course_offer_id": {
      "type": "string",
      "description": "Central de Matr\u00edcula: ID da oferta (CourseOffer) \u2014 compat\u00edvel/sincronizado com oferta_id legado"
    },
    "seat_reservation_id": {
      "type": "string",
      "description": "Central de Matr\u00edcula: ID da reserva de vaga (SeatReservation) vinculada"
    },
    "discount_authorization_id": {
      "type": "string",
      "description": "Central de Matr\u00edcula: ID da autoriza\u00e7\u00e3o de desconto (DiscountAuthorization) aplicada"
    },
    "discount_code_snapshot": {
      "type": "string",
      "description": "Central de Matr\u00edcula: c\u00f3digo de desconto aplicado (snapshot imut\u00e1vel)"
    },
    "discount_percentage_snapshot": {
      "type": "number",
      "description": "Central de Matr\u00edcula: percentual de desconto aplicado (snapshot imut\u00e1vel)"
    },
    "discount_amount": {
      "type": "number",
      "description": "Central de Matr\u00edcula: valor descontado em R$ (snapshot)"
    },
    "final_amount": {
      "type": "number",
      "description": "Central de Matr\u00edcula: valor final ap\u00f3s desconto (snapshot)"
    },
    "contract_id": {
      "type": "string",
      "description": "Central de Matr\u00edcula: ID do contrato (Contract) vinculado"
    },
    "portal_access_account_id": {
      "type": "string",
      "description": "Central de Matr\u00edcula: ID da conta de acesso ao portal (AccessAccount) do aluno"
    },
    "cancellation_reason": {
      "type": "string",
      "description": "Central de Matr\u00edcula: justificativa do cancelamento"
    },
    "transfer_from_enrollment_id": {
      "type": "string",
      "description": "Central de Matr\u00edcula: ID da matr\u00edcula de origem (quando esta foi criada por transfer\u00eancia)"
    },
    "transfer_to_enrollment_id": {
      "type": "string",
      "description": "Central de Matr\u00edcula: ID da matr\u00edcula de destino (quando esta foi transferida)"
    },
    "transfer_reason": {
      "type": "string",
      "description": "Central de Matr\u00edcula: justificativa da transfer\u00eancia"
    },
    "suspended_at": {
      "type": "string",
      "format": "date-time",
      "description": "Central de Matr\u00edcula: data/hora da suspens\u00e3o"
    },
    "reactivated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Central de Matr\u00edcula: data/hora da reativa\u00e7\u00e3o"
    },
    "last_pending_reason": {
      "type": "string",
      "description": "Central de Matr\u00edcula: \u00faltima pend\u00eancia registrada"
    },
    "last_pending_at": {
      "type": "string",
      "format": "date-time",
      "description": "Central de Matr\u00edcula: data/hora da \u00faltima pend\u00eancia"
    },
    "import_batch_id": {
      "type": "string",
      "description": "Importa\u00e7\u00e3o por Planilha: ID do lote (ImportBatch) que criou esta matr\u00edcula (opcional, retrocompat\u00edvel)"
    },
    "import_archived": {
      "type": "boolean",
      "default": false,
      "description": "Importa\u00e7\u00e3o por Planilha: registro arquivado em massa via lote (opcional, retrocompat\u00edvel)"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "student_id",
    "student_name",
    "student_cpf",
    "course_id",
    "course_name",
    "company_id",
    "company_name",
    "start_date",
    "end_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordenacao"
          }
        },
        {
          "user_condition": {
            "role": "atendimento"
          }
        },
        {
          "user_condition": {
            "role": "certificacao"
          }
        },
        {
          "user_condition": {
            "role": "personalizado"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.student_id": "{{user.student_id}}"
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordenacao"
          }
        },
        {
          "user_condition": {
            "role": "atendimento"
          }
        },
        {
          "user_condition": {
            "role": "financeiro"
          }
        },
        {
          "user_condition": {
            "role": "auditor"
          }
        },
        {
          "user_condition": {
            "role": "certificacao"
          }
        },
        {
          "user_condition": {
            "role": "personalizado"
          }
        },
        {
          "user_condition": {
            "role": "cliente"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordenacao"
          }
        },
        {
          "user_condition": {
            "role": "atendimento"
          }
        },
        {
          "user_condition": {
            "role": "certificacao"
          }
        },
        {
          "user_condition": {
            "role": "personalizado"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}