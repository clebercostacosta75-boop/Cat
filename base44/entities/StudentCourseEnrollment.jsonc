{
  "name": "StudentCourseEnrollment",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "ID do aluno (refer\u00eancia \u00e0 entidade Student)"
    },
    "student_name": {
      "type": "string",
      "description": "Nome do aluno (desnormalizado para consultas)"
    },
    "student_cpf": {
      "type": "string",
      "description": "CPF do aluno"
    },
    "student_email": {
      "type": "string",
      "description": "E-mail do aluno"
    },
    "student_phone": {
      "type": "string",
      "description": "WhatsApp do aluno"
    },
    "course_id": {
      "type": "string",
      "description": "ID do curso (refer\u00eancia \u00e0 entidade Course)"
    },
    "course_name": {
      "type": "string",
      "description": "Nome do curso (desnormalizado)"
    },
    "course_duration": {
      "type": "string",
      "description": "Carga hor\u00e1ria do curso (ex: 8h)"
    },
    "certification_type": {
      "type": "string",
      "enum": [
        "Forma\u00e7\u00e3o",
        "Atualiza\u00e7\u00e3o",
        "Reciclagem"
      ],
      "default": "Forma\u00e7\u00e3o",
      "description": "Tipo da certifica\u00e7\u00e3o: Forma\u00e7\u00e3o, Atualiza\u00e7\u00e3o ou Reciclagem"
    },
    "validity_months": {
      "type": "number",
      "description": "Validade em meses (vinda do modelo de certificado ou curso)"
    },
    "company_id": {
      "type": "string",
      "description": "ID da empresa contratante (refer\u00eancia \u00e0 entidade Company)"
    },
    "company_name": {
      "type": "string",
      "description": "Nome da empresa contratante"
    },
    "instructor_id": {
      "type": "string",
      "description": "ID do instrutor respons\u00e1vel"
    },
    "instructor_name": {
      "type": "string",
      "description": "Nome do instrutor respons\u00e1vel"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio do curso"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Data de t\u00e9rmino do curso"
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento calculada automaticamente (end_date + validity_months)"
    },
    "certificate_model_id": {
      "type": "string",
      "description": "ID do modelo de certificado utilizado"
    },
    "certificate_model_name": {
      "type": "string",
      "description": "Nome do modelo de certificado"
    },
    "certificate_id": {
      "type": "string",
      "description": "ID do certificado gerado (ap\u00f3s autoriza\u00e7\u00e3o)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aguardando Autoriza\u00e7\u00e3o",
        "Autorizado",
        "Certificado Gerado",
        "Assinado",
        "Vencido",
        "Revogado"
      ],
      "default": "Aguardando Autoriza\u00e7\u00e3o",
      "description": "Status da matr\u00edcula/certificado"
    },
    "status_matricula": {
      "type": "string",
      "enum": [
        "Matriculado",
        "Em Andamento",
        "Conclu\u00eddo",
        "Cancelado"
      ],
      "default": "Matriculado",
      "description": "Ciclo acad\u00eamico da matr\u00edcula (SPR-A) \u2014 independente do ciclo de certificado"
    },
    "resultado_academico": {
      "type": "string",
      "enum": [
        "Pendente",
        "Aprovado",
        "Reprovado",
        "N\u00e3o Concluiu"
      ],
      "default": "Pendente",
      "description": "Resultado acad\u00eamico oficial (SPR-A) \u2014 definido na Gest\u00e3o Acad\u00eamica. Somente Aprovado permite certifica\u00e7\u00e3o"
    },
    "data_resultado": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que o resultado acad\u00eamico foi definido"
    },
    "responsavel_resultado": {
      "type": "string",
      "description": "Nome/e-mail de quem definiu o resultado acad\u00eamico"
    },
    "observacao_resultado": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o/justificativa do resultado acad\u00eamico"
    },
    "apto_certificacao": {
      "type": "boolean",
      "default": false,
      "description": "Se a matr\u00edcula est\u00e1 apta para certifica\u00e7\u00e3o (aprovado + sem pend\u00eancias bloqueantes)"
    },
    "data_apto_certificacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que a matr\u00edcula ficou apta para certifica\u00e7\u00e3o"
    },
    "bloqueio_certificacao": {
      "type": "boolean",
      "default": false,
      "description": "Bloqueio manual de certifica\u00e7\u00e3o (impede emiss\u00e3o mesmo aprovado)"
    },
    "motivo_bloqueio_certificacao": {
      "type": "string",
      "description": "Motivo do bloqueio manual de certifica\u00e7\u00e3o"
    },
    "liberacao_financeira_manual": {
      "type": "boolean",
      "default": false,
      "description": "SPR-2A: libera\u00e7\u00e3o financeira manual aprovada pelo Financeiro (permite certifica\u00e7\u00e3o mesmo sem pagamento quitado)"
    },
    "liberacao_financeira_por": {
      "type": "string",
      "description": "SPR-2A: e-mail do respons\u00e1vel do Financeiro que aprovou a libera\u00e7\u00e3o manual"
    },
    "liberacao_financeira_em": {
      "type": "string",
      "format": "date-time",
      "description": "SPR-2A: data/hora da libera\u00e7\u00e3o financeira manual"
    },
    "liberacao_financeira_justificativa": {
      "type": "string",
      "description": "SPR-2A: justificativa obrigat\u00f3ria da libera\u00e7\u00e3o financeira manual"
    },
    "authorized_by": {
      "type": "string",
      "description": "E-mail do respons\u00e1vel que autorizou"
    },
    "authorized_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da autoriza\u00e7\u00e3o"
    },
    "class_schedule_id": {
      "type": "string",
      "description": "ID da turma vinculada (opcional)"
    },
    "unit_value": {
      "type": "number",
      "description": "Valor do curso para este aluno individual (PF)"
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "\u00c0 Vista",
        "Parcelado 2x",
        "Parcelado 3x",
        "Parcelado 4x",
        "Parcelado 5x",
        "Parcelado 6x",
        "Boleto",
        "Pix",
        "Cart\u00e3o de Cr\u00e9dito",
        "Cart\u00e3o de D\u00e9bito",
        "Transfer\u00eancia Banc\u00e1ria"
      ],
      "description": "Forma de pagamento do curso"
    },
    "status_pagamento": {
      "type": "string",
      "enum": [
        "Pendente",
        "Pago",
        "Parcialmente Pago",
        "Inadimplente"
      ],
      "default": "Pendente",
      "description": "Status do pagamento"
    },
    "data_vencimento_pagamento": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento do pagamento"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "student_id",
    "student_name",
    "student_cpf",
    "course_id",
    "course_name",
    "company_id",
    "company_name",
    "start_date",
    "end_date"
  ]
}