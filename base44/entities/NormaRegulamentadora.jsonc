{
  "name": "NormaRegulamentadora",
  "type": "object",
  "properties": {
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo da NR (ex: NR-12, NR-35)"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo oficial da NR"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o resumida da norma"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Seguran\u00e7a",
        "Sa\u00fade",
        "Medicina",
        "Ergonomia",
        "Constru\u00e7\u00e3o",
        "M\u00e1quinas",
        "Eletricidade",
        "Qu\u00edmica",
        "Geral"
      ],
      "description": "Categoria da NR"
    },
    "obrigatoria": {
      "type": "boolean",
      "default": true,
      "description": "Se \u00e9 obrigat\u00f3ria para a matriz"
    },
    "periodicidade_padrao_meses": {
      "type": "number",
      "description": "Periodicidade padr\u00e3o de reciclagem em meses (ex: 12, 24)"
    },
    "carga_horaria_minima": {
      "type": "number",
      "description": "Carga hor\u00e1ria m\u00ednima exigida (horas)"
    }
  },
  "required": [
    "codigo",
    "titulo"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}