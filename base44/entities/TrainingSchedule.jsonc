{
  "name": "TrainingSchedule",
  "type": "object",
  "properties": {
    "training_name": {
      "type": "string",
      "description": "Nome do treinamento"
    },
    "instructor_name": {
      "type": "string",
      "description": "Nome do instrutor"
    },
    "company": {
      "type": "string",
      "description": "Empresa"
    },
    "month": {
      "type": "string",
      "description": "M\u00eas do treinamento"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data do treinamento"
    },
    "start_time": {
      "type": "string",
      "description": "Hor\u00e1rio de in\u00edcio (ex: 08:00)"
    },
    "end_time": {
      "type": "string",
      "description": "Hor\u00e1rio de t\u00e9rmino (ex: 17:00)"
    },
    "hours": {
      "type": "number",
      "description": "Quantidade de horas"
    },
    "instructor_cost": {
      "type": "number",
      "description": "Custo do instrutor (HP)"
    },
    "standard_value": {
      "type": "number",
      "description": "Valor padr\u00e3o do curso"
    },
    "cost_difference": {
      "type": "number",
      "description": "Diferen\u00e7a de valor (Custo HP - Valor Padr\u00e3o)"
    },
    "participants": {
      "type": "number",
      "description": "N\u00famero de participantes"
    },
    "status": {
      "type": "string",
      "enum": [
        "Planejado",
        "Confirmado",
        "Realizado",
        "Cancelado"
      ],
      "default": "Planejado",
      "description": "Status do treinamento"
    },
    "location": {
      "type": "string",
      "description": "Local onde ser\u00e1 realizado o treinamento (endere\u00e7o completo)"
    },
    "room": {
      "type": "string",
      "description": "Sala/Audit\u00f3rio"
    },
    "logistics": {
      "type": "string",
      "description": "Informa\u00e7\u00f5es de log\u00edstica (materiais, equipamentos, coffee break, etc)"
    },
    "pedagogical_content": {
      "type": "string",
      "description": "Conte\u00fado program\u00e1tico e objetivos do treinamento"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "Data prevista de pagamento ao instrutor"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "Pendente",
        "Agendado",
        "Pago"
      ],
      "default": "Pendente",
      "description": "Status do pagamento"
    },
    "company_contact_email": {
      "type": "string",
      "format": "email",
      "description": "E-mail de contato da empresa"
    },
    "company_contact_phone": {
      "type": "string",
      "description": "WhatsApp/Telefone da empresa"
    },
    "notifications_sent": {
      "type": "boolean",
      "default": false,
      "description": "Indica se as notifica\u00e7\u00f5es j\u00e1 foram enviadas"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "training_name",
    "instructor_name",
    "company",
    "month"
  ]
}