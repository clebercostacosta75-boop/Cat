{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio (refer\u00eancia ao User)"
    },
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio"
    },
    "user_name": {
      "type": "string",
      "description": "Nome do usu\u00e1rio"
    },
    "role": {
      "type": "string",
      "enum": [
        "gestor_master",
        "editor",
        "cliente"
      ],
      "default": "cliente",
      "description": "Perfil de acesso"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Permiss\u00f5es individuais de acesso \u00e0s p\u00e1ginas do sistema"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "blocked",
        "pending_password_change"
      ],
      "default": "pending_password_change",
      "description": "Status do usu\u00e1rio"
    },
    "company_permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "company_id": {
            "type": "string"
          },
          "company_name": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "view",
                "edit",
                "manage_users"
              ]
            }
          }
        }
      },
      "description": "Permiss\u00f5es por empresa"
    },
    "initial_password": {
      "type": "string",
      "description": "Senha inicial gerada (apenas para envio)"
    },
    "password_changed": {
      "type": "boolean",
      "default": false,
      "description": "Se o usu\u00e1rio j\u00e1 trocou a senha"
    },
    "last_login": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltimo acesso"
    },
    "credentials_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data de envio das credenciais"
    },
    "credentials_sent_via": {
      "type": "string",
      "enum": [
        "whatsapp",
        "email",
        "manual"
      ],
      "description": "Canal de envio das credenciais"
    },
    "credentials_sent_by": {
      "type": "string",
      "description": "Quem enviou as credenciais"
    },
    "phone": {
      "type": "string",
      "description": "Telefone para contato/WhatsApp"
    },
    "consent_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora do aceite do termo de consentimento LGPD"
    },
    "consent_ip_address": {
      "type": "string",
      "description": "Endere\u00e7o IP de onde o consentimento foi dado"
    },
    "consent_term_version": {
      "type": "string",
      "description": "Vers\u00e3o do termo de consentimento aceito (ex: v1.0)"
    }
  },
  "required": [
    "user_email",
    "user_name",
    "role"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}