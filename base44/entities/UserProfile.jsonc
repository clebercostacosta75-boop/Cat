{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID imut\u00e1vel da conta User vinculada"
    },
    "user_email": {
      "type": "string",
      "description": "E-mail normalizado usado apenas para reconcilia\u00e7\u00e3o"
    },
    "user_name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "gestor_master",
        "admin",
        "comercial",
        "financeiro",
        "coordenacao",
        "instrutor",
        "aluno",
        "empresa",
        "auditor",
        "editor",
        "cliente",
        "personalizado"
      ],
      "default": "cliente",
      "description": "Papel can\u00f4nico de acesso"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs can\u00f4nicos dos m\u00f3dulos permitidos"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "blocked",
        "pending_password_change"
      ],
      "default": "pending_password_change"
    },
    "company_permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "company_id": {
            "type": "string"
          },
          "company_name": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "view",
                "edit",
                "manage_users"
              ]
            }
          }
        }
      }
    },
    "student_id": {
      "type": "string",
      "description": "V\u00ednculo do Portal do Aluno"
    },
    "cpf": {
      "type": "string",
      "description": "CPF normalizado do titular"
    },
    "instructor_id": {
      "type": "string",
      "description": "V\u00ednculo do Portal do Instrutor"
    },
    "colaborador_sst_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pgr_leitura_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ltcat_detalhe_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "initial_password": {
      "type": "string"
    },
    "password_changed": {
      "type": "boolean",
      "default": false
    },
    "last_login": {
      "type": "string",
      "format": "date-time"
    },
    "credentials_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "credentials_sent_via": {
      "type": "string",
      "enum": [
        "whatsapp",
        "email",
        "manual"
      ]
    },
    "credentials_sent_by": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "consent_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "consent_ip_address": {
      "type": "string"
    },
    "consent_term_version": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "user_name",
    "role"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}