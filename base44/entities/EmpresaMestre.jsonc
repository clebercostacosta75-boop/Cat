{
  "name": "EmpresaMestre",
  "type": "object",
  "properties": {
    "cnpj": {
      "type": "string",
      "description": "CNPJ \u00fanico da empresa (identificador mestre)"
    },
    "razao_social": {
      "type": "string",
      "description": "Raz\u00e3o social da empresa"
    },
    "nome_fantasia": {
      "type": "string"
    },
    "cnae": {
      "type": "string",
      "description": "C\u00f3digo CNAE principal"
    },
    "cnae_descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da atividade econ\u00f4mica"
    },
    "grau_risco": {
      "type": "string",
      "enum": [
        "1",
        "2",
        "3",
        "4"
      ],
      "description": "Grau de risco (NR-4)"
    },
    "inscricao_estadual": {
      "type": "string"
    },
    "endereco": {
      "type": "string"
    },
    "municipio": {
      "type": "string"
    },
    "estado": {
      "type": "string"
    },
    "cep": {
      "type": "string"
    },
    "responsavel_legal": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "telefone": {
      "type": "string"
    },
    "qtd_colaboradores": {
      "type": "number"
    },
    "status_empresa": {
      "type": "string",
      "enum": [
        "Ativa",
        "Inativa",
        "Em Auditoria"
      ],
      "default": "Ativa"
    },
    "observacoes": {
      "type": "string"
    },
    "data_cadastro": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "cnpj",
    "razao_social"
  ]
}