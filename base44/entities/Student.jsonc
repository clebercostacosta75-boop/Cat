{
  "name": "Student",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Nome completo do aluno"
    },
    "social_name": {
      "type": "string",
      "description": "Nome social do aluno (se houver)"
    },
    "cpf": {
      "type": "string",
      "description": "CPF do aluno"
    },
    "rg": {
      "type": "string",
      "description": "RG do aluno"
    },
    "rg_orgao_emissor": {
      "type": "string",
      "description": "\u00d3rg\u00e3o emissor do RG (ex: SSP/PA)"
    },
    "ra": {
      "type": "string",
      "description": "RA (Registro de Aluno) do aluno"
    },
    "data_nascimento": {
      "type": "string",
      "format": "date",
      "description": "Data de nascimento do aluno"
    },
    "sexo": {
      "type": "string",
      "enum": [
        "Masculino",
        "Feminino",
        "Outro",
        "Prefiro n\u00e3o informar"
      ],
      "description": "Sexo do aluno"
    },
    "email": {
      "type": "string",
      "description": "E-mail do aluno"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp do aluno (com DDD)"
    },
    "cep": {
      "type": "string",
      "description": "CEP do endere\u00e7o"
    },
    "logradouro": {
      "type": "string",
      "description": "Rua/Logradouro"
    },
    "numero": {
      "type": "string",
      "description": "N\u00famero do endere\u00e7o"
    },
    "complemento": {
      "type": "string",
      "description": "Complemento do endere\u00e7o"
    },
    "bairro": {
      "type": "string",
      "description": "Bairro"
    },
    "cidade": {
      "type": "string",
      "description": "Cidade"
    },
    "estado": {
      "type": "string",
      "description": "Estado (UF)"
    },
    "resp_financeiro_nome": {
      "type": "string",
      "description": "Nome do respons\u00e1vel financeiro"
    },
    "resp_financeiro_cpf": {
      "type": "string",
      "description": "CPF do respons\u00e1vel financeiro"
    },
    "resp_financeiro_telefone": {
      "type": "string",
      "description": "Telefone do respons\u00e1vel financeiro"
    },
    "resp_financeiro_email": {
      "type": "string",
      "description": "E-mail do respons\u00e1vel financeiro"
    },
    "company_id": {
      "type": "string",
      "description": "ID da empresa vinculada"
    },
    "company_name": {
      "type": "string",
      "description": "Nome da empresa vinculada"
    },
    "funcao_id": {
      "type": "string",
      "description": "ID da fun\u00e7\u00e3o/cargo do colaborador (refer\u00eancia FuncaoCargo)"
    },
    "funcao_nome": {
      "type": "string",
      "description": "Nome da fun\u00e7\u00e3o/cargo do colaborador"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Inativo"
      ],
      "default": "Ativo",
      "description": "Status do aluno"
    },
    "origem": {
      "type": "string",
      "enum": [
        "CAT App",
        "DKSoft"
      ],
      "default": "CAT App",
      "description": "Sistema de origem do cadastro do aluno"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "full_name",
    "cpf"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "user_condition": {
            "role": "coordenacao"
          }
        },
        {
          "user_condition": {
            "role": "certificacao"
          }
        },
        {
          "user_condition": {
            "role": "atendimento"
          }
        },
        {
          "user_condition": {
            "role": "personalizado"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "user_condition": {
            "role": "coordenacao"
          }
        },
        {
          "user_condition": {
            "role": "certificacao"
          }
        },
        {
          "user_condition": {
            "role": "atendimento"
          }
        },
        {
          "user_condition": {
            "role": "financeiro"
          }
        },
        {
          "user_condition": {
            "role": "auditor"
          }
        },
        {
          "user_condition": {
            "role": "personalizado"
          }
        },
        {
          "user_condition": {
            "role": "cliente"
          }
        },
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "user_condition": {
            "role": "coordenacao"
          }
        },
        {
          "user_condition": {
            "role": "certificacao"
          }
        },
        {
          "user_condition": {
            "role": "atendimento"
          }
        },
        {
          "user_condition": {
            "role": "personalizado"
          }
        },
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}