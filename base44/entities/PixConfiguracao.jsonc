{
  "name": "PixConfiguracao",
  "type": "object",
  "properties": {
    "favorecido": {
      "type": "string",
      "description": "Nome do favorecido da conta Pix"
    },
    "cpf_cnpj": {
      "type": "string",
      "description": "CPF/CNPJ do favorecido"
    },
    "banco": {
      "type": "string",
      "description": "Banco/institui\u00e7\u00e3o da conta"
    },
    "tipo_chave": {
      "type": "string",
      "enum": [
        "CPF/CNPJ",
        "E-mail",
        "Celular",
        "Chave Aleat\u00f3ria"
      ],
      "default": "CPF/CNPJ",
      "description": "Tipo da chave Pix"
    },
    "chave": {
      "type": "string",
      "description": "Chave Pix (copia-e-cola)"
    },
    "qr_code_url": {
      "type": "string",
      "description": "URL da imagem do QR Code da chave"
    },
    "ativo": {
      "type": "boolean",
      "default": false,
      "description": "Se esta \u00e9 a chave Pix ativa exibida nas matr\u00edculas (apenas uma ativa por vez)"
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es internas"
    },
    "atualizado_por": {
      "type": "string",
      "description": "E-mail do respons\u00e1vel do Financeiro pela \u00faltima altera\u00e7\u00e3o"
    }
  },
  "required": [
    "favorecido",
    "chave"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "user_condition": {
            "role": "financeiro"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "user_condition": {
            "role": "financeiro"
          }
        },
        {
          "user_condition": {
            "role": "coordenacao"
          }
        },
        {
          "user_condition": {
            "role": "atendimento"
          }
        },
        {
          "user_condition": {
            "role": "auditor"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "user_condition": {
            "role": "financeiro"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}