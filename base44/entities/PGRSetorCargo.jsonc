{
  "name": "PGRSetorCargo",
  "type": "object",
  "properties": {
    "pgr_leitura_id": {
      "type": "string"
    },
    "setor": {
      "type": "string"
    },
    "cargo": {
      "type": "string"
    },
    "funcao": {
      "type": "string"
    },
    "qtd_trabalhadores": {
      "type": "number"
    },
    "ghe": {
      "type": "string"
    },
    "descricao_atividades": {
      "type": "string"
    },
    "jornada_trabalho": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "data.pgr_leitura_id": {
            "$in": "{{user.pgr_leitura_ids}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}