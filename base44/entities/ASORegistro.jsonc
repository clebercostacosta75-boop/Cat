{
  "name": "ASORegistro",
  "type": "object",
  "properties": {
    "empresa_mestre_id": {
      "type": "string"
    },
    "empresa_mestre_nome": {
      "type": "string"
    },
    "colaborador_sst_id": {
      "type": "string"
    },
    "nome_colaborador": {
      "type": "string"
    },
    "cpf": {
      "type": "string"
    },
    "funcao": {
      "type": "string"
    },
    "data_exame": {
      "type": "string",
      "format": "date"
    },
    "tipo_exame": {
      "type": "string",
      "enum": [
        "Admissional",
        "Peri\u00f3dico",
        "Retorno ao Trabalho",
        "Mudan\u00e7a de Risco",
        "Demissional"
      ]
    },
    "medico_responsavel": {
      "type": "string"
    },
    "crm": {
      "type": "string"
    },
    "resultado": {
      "type": "string",
      "enum": [
        "Apto",
        "Apto com Restri\u00e7\u00e3o",
        "Inapto"
      ]
    },
    "arquivo_pdf": {
      "type": "string"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "V\u00e1lido",
        "Vencendo",
        "Vencido"
      ],
      "default": "V\u00e1lido"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "data.empresa_mestre_id": {
            "$in": "{{user.company_permissions.company_id}}"
          }
        },
        {
          "data.colaborador_sst_id": {
            "$in": "{{user.colaborador_sst_ids}}"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "data.empresa_mestre_id": {
            "$in": "{{user.company_permissions.company_id}}"
          }
        },
        {
          "data.colaborador_sst_id": {
            "$in": "{{user.colaborador_sst_ids}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}