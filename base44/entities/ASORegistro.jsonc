{
  "name": "ASORegistro",
  "type": "object",
  "properties": {
    "empresa_mestre_id": {
      "type": "string"
    },
    "empresa_mestre_nome": {
      "type": "string"
    },
    "colaborador_sst_id": {
      "type": "string"
    },
    "nome_colaborador": {
      "type": "string"
    },
    "cpf": {
      "type": "string"
    },
    "funcao": {
      "type": "string"
    },
    "data_exame": {
      "type": "string",
      "format": "date"
    },
    "tipo_exame": {
      "type": "string",
      "enum": [
        "Admissional",
        "Peri\u00f3dico",
        "Retorno ao Trabalho",
        "Mudan\u00e7a de Risco",
        "Demissional"
      ]
    },
    "medico_responsavel": {
      "type": "string"
    },
    "crm": {
      "type": "string"
    },
    "resultado": {
      "type": "string",
      "enum": [
        "Apto",
        "Apto com Restri\u00e7\u00e3o",
        "Inapto"
      ]
    },
    "arquivo_pdf": {
      "type": "string"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "V\u00e1lido",
        "Vencendo",
        "Vencido"
      ],
      "default": "V\u00e1lido"
    },
    "observacoes_aso": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do ASO \u2014 inclui exames obrigat\u00f3rios e periodicidade quando gerado automaticamente"
    },
    "gerado_automaticamente": {
      "type": "boolean",
      "default": false,
      "description": "Se o ASO foi gerado automaticamente pelo processamento do PCMSO via IA"
    },
    "pcmso_id": {
      "type": "string",
      "description": "ID do DocumentoPCMSO que originou este ASO (quando gerado automaticamente)"
    }
  },
  "required": []
}