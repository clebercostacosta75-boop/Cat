{
  "name": "RegistroExame",
  "type": "object",
  "properties": {
    "colaborador_nome": {
      "type": "string",
      "description": "Nome do colaborador"
    },
    "cpf": {
      "type": "string",
      "description": "CPF do colaborador"
    },
    "cargo": {
      "type": "string",
      "description": "Cargo/fun\u00e7\u00e3o do colaborador"
    },
    "empresa_nome": {
      "type": "string",
      "description": "Nome da empresa"
    },
    "tipo_exame": {
      "type": "string",
      "enum": [
        "Admissional",
        "Peri\u00f3dico",
        "Demissional",
        "Retorno ao Trabalho",
        "Mudan\u00e7a de Risco"
      ],
      "description": "Tipo do exame"
    },
    "data_realizacao": {
      "type": "string",
      "format": "date",
      "description": "Data de realiza\u00e7\u00e3o"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento"
    },
    "medico_responsavel": {
      "type": "string",
      "description": "Nome do m\u00e9dico"
    },
    "crm": {
      "type": "string",
      "description": "CRM do m\u00e9dico"
    },
    "resultado": {
      "type": "string",
      "enum": [
        "Apto",
        "Apto com Restri\u00e7\u00f5es",
        "Inapto"
      ],
      "description": "Resultado do exame"
    },
    "arquivo_pdf": {
      "type": "string",
      "description": "URL do arquivo PDF do ASO"
    },
    "status": {
      "type": "string",
      "enum": [
        "V\u00e1lido",
        "Vencido",
        "Pendente"
      ],
      "default": "V\u00e1lido"
    },
    "observacoes": {
      "type": "string"
    },
    "extraido_por_ia": {
      "type": "boolean",
      "default": false
    },
    "data_upload": {
      "type": "string",
      "format": "date"
    }
  },
  "required": []
}