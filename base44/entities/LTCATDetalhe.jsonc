{
  "name": "LTCATDetalhe",
  "type": "object",
  "properties": {
    "empresa_mestre_id": {
      "type": "string"
    },
    "empresa_mestre_nome": {
      "type": "string"
    },
    "documento_ltcat_id": {
      "type": "string"
    },
    "numero_ltcat": {
      "type": "string"
    },
    "crea": {
      "type": "string"
    },
    "art": {
      "type": "string"
    },
    "vigencia_fim": {
      "type": "string",
      "format": "date"
    },
    "status_doc": {
      "type": "string",
      "enum": [
        "Vigente",
        "Vencendo",
        "Vencido"
      ],
      "default": "Vigente"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "data.empresa_mestre_id": {
            "$in": "{{user.company_permissions.company_id}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}