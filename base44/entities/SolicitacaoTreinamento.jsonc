{
  "name": "SolicitacaoTreinamento",
  "type": "object",
  "properties": {
    "empresa_mestre_id": {
      "type": "string"
    },
    "empresa_mestre_nome": {
      "type": "string"
    },
    "tipo_solicitacao": {
      "type": "string",
      "enum": [
        "Empresa Solicita",
        "CAT Programa"
      ],
      "default": "Empresa Solicita"
    },
    "origem": {
      "type": "string",
      "enum": [
        "Portal Empresa",
        "Portal CAT"
      ],
      "default": "Portal Empresa"
    },
    "titulo_treinamento": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "nr_relacionada": {
      "type": "string"
    },
    "numero_participantes": {
      "type": "number"
    },
    "colaboradores_nomes": {
      "type": "string"
    },
    "data_preferencial": {
      "type": "string",
      "format": "date"
    },
    "local_preferencial": {
      "type": "string",
      "enum": [
        "Presencial",
        "Online",
        "H\u00edbrido"
      ],
      "default": "Presencial"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aguardando An\u00e1lise",
        "Em An\u00e1lise",
        "Aprovado",
        "Agendado",
        "Conclu\u00eddo",
        "Cancelado"
      ],
      "default": "Aguardando An\u00e1lise"
    },
    "instrutor_designado": {
      "type": "string"
    },
    "custo_estimado": {
      "type": "number"
    },
    "data_confirmada": {
      "type": "string",
      "format": "date"
    },
    "horario_inicio": {
      "type": "string"
    },
    "horario_fim": {
      "type": "string"
    },
    "link_online": {
      "type": "string"
    },
    "observacoes_cat": {
      "type": "string"
    },
    "notificacao_enviada": {
      "type": "boolean",
      "default": false
    },
    "data_notificacao": {
      "type": "string",
      "format": "date"
    },
    "company_id": {
      "type": "string",
      "description": "Portal da Empresa (opcional, retrocompat\u00edvel): ID da Company vinculada \u2014 compat\u00edvel com empresa_mestre_id"
    },
    "course_id": {
      "type": "string",
      "description": "Portal da Empresa (opcional): ID do curso relacionado"
    },
    "course_name": {
      "type": "string",
      "description": "Portal da Empresa (opcional): nome do curso relacionado"
    },
    "student_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Portal da Empresa (opcional): IDs dos alunos envolvidos"
    },
    "student_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Portal da Empresa (opcional): nomes dos alunos envolvidos"
    },
    "certificate_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Portal da Empresa (opcional): IDs dos certificados que originaram a solicita\u00e7\u00e3o"
    },
    "motivo_renovacao": {
      "type": "string",
      "description": "Portal da Empresa (opcional): motivo da renova\u00e7\u00e3o/reciclagem informado pela empresa"
    },
    "prazo_alerta_origem": {
      "type": "string",
      "description": "Portal da Empresa (opcional): situa\u00e7\u00e3o/prazo de alerta que originou a solicita\u00e7\u00e3o (ex: Vence em 30 dias)"
    }
  },
  "required": [
    "titulo_treinamento"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "data.empresa_mestre_id": {
            "$in": "{{user.company_permissions.company_id}}"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "data.empresa_mestre_id": {
            "$in": "{{user.company_permissions.company_id}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}