{
  "name": "Company",
  "type": "object",
  "properties": {
    "razao_social": {
      "type": "string",
      "description": "Raz\u00e3o Social da empresa"
    },
    "nome_fantasia": {
      "type": "string",
      "description": "Nome Fantasia"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ da empresa"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Inativo"
      ],
      "default": "Ativo",
      "description": "Status da empresa"
    },
    "logo_url": {
      "type": "string",
      "description": "URL do logo da empresa"
    },
    "default_bmm_template_id": {
      "type": "string",
      "description": "ID do modelo de BMM padr\u00e3o para esta empresa"
    },
    "email_faturamento": {
      "type": "string",
      "format": "email",
      "description": "Email para envio de BMM e faturamento"
    },
    "additional_services": {
      "type": "object",
      "description": "Servi\u00e7os adicionais fornecidos pela contratada (coffee break, almo\u00e7o)",
      "properties": {
        "coffee_break_morning_enabled": {
          "type": "boolean",
          "default": false,
          "description": "Oferece coffee break manh\u00e3"
        },
        "coffee_break_morning_unit_value": {
          "type": "number",
          "default": 0,
          "description": "Valor unit\u00e1rio por pessoa - coffee break manh\u00e3 (R$)"
        },
        "coffee_break_afternoon_enabled": {
          "type": "boolean",
          "default": false,
          "description": "Oferece coffee break tarde"
        },
        "coffee_break_afternoon_unit_value": {
          "type": "number",
          "default": 0,
          "description": "Valor unit\u00e1rio por pessoa - coffee break tarde (R$)"
        },
        "lunch_enabled": {
          "type": "boolean",
          "default": false,
          "description": "Oferece almo\u00e7o"
        },
        "lunch_unit_value": {
          "type": "number",
          "default": 0,
          "description": "Valor unit\u00e1rio por pessoa - almo\u00e7o (R$)"
        }
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "object",
            "properties": {
              "street": {
                "type": "string"
              },
              "number": {
                "type": "string"
              },
              "complement": {
                "type": "string"
              },
              "neighborhood": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "zip_code": {
                "type": "string"
              }
            }
          }
        }
      },
      "description": "Unidades/Localiza\u00e7\u00f5es da empresa"
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "unit_name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "is_whatsapp": {
            "type": "boolean",
            "default": false
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "description": "Contatos da empresa"
    },
    "billing_info": {
      "type": "object",
      "properties": {
        "contact_reference": {
          "type": "string"
        },
        "contract_object": {
          "type": "string"
        }
      },
      "description": "Informa\u00e7\u00f5es de faturamento"
    },
    "fiscal_name": {
      "type": "string"
    },
    "fiscal_role": {
      "type": "string"
    },
    "contract_manager_name": {
      "type": "string"
    },
    "contract_manager_role": {
      "type": "string"
    },
    "company_courses": {
      "type": "array",
      "description": "Cursos com valores personalizados para esta empresa",
      "items": {
        "type": "object",
        "properties": {
          "course_id": {
            "type": "string"
          },
          "course_name": {
            "type": "string"
          },
          "workload_hours": {
            "type": "number"
          },
          "modality": {
            "type": "string",
            "enum": [
              "Presencial",
              "H\u00edbrido",
              "Online"
            ]
          },
          "theoretical_hours": {
            "type": "number"
          },
          "practical_hours": {
            "type": "number"
          },
          "billing_type": {
            "type": "string",
            "enum": [
              "per_student",
              "per_closed_class"
            ],
            "default": "per_student"
          },
          "specific_price": {
            "type": "number"
          },
          "class_fixed_value": {
            "type": "number"
          },
          "included_students_limit": {
            "type": "number",
            "default": 15
          }
        },
        "required": [
          "course_id",
          "course_name",
          "modality",
          "workload_hours"
        ]
      }
    },
    "company_contracts": {
      "type": "array",
      "description": "Contratos da empresa",
      "items": {
        "type": "object",
        "properties": {
          "contract_number": {
            "type": "string"
          },
          "amendment_number": {
            "type": "string"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Ativo",
              "Vencido",
              "Cancelado"
            ],
            "default": "Ativo"
          }
        },
        "required": [
          "contract_number",
          "start_date",
          "end_date"
        ]
      }
    }
  },
  "required": [
    "razao_social",
    "nome_fantasia",
    "cnpj"
  ]
}