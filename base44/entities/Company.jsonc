{
  "name": "Company",
  "type": "object",
  "properties": {
    "razao_social": {
      "type": "string",
      "description": "Raz\u00e3o Social da empresa"
    },
    "nome_fantasia": {
      "type": "string",
      "description": "Nome Fantasia"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ da empresa"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Inativo"
      ],
      "default": "Ativo",
      "description": "Status da empresa"
    },
    "bloqueio_financeiro": {
      "type": "boolean",
      "default": false,
      "description": "SPR-2A: bloqueio financeiro da empresa \u2014 impede certifica\u00e7\u00e3o de matr\u00edculas vinculadas"
    },
    "motivo_bloqueio_financeiro": {
      "type": "string",
      "description": "SPR-2A: motivo do bloqueio financeiro da empresa"
    },
    "bloqueio_financeiro_por": {
      "type": "string",
      "description": "SPR-2A: e-mail do respons\u00e1vel que aplicou o bloqueio financeiro"
    },
    "bloqueio_financeiro_em": {
      "type": "string",
      "format": "date-time",
      "description": "SPR-2A: data/hora do bloqueio financeiro"
    },
    "logo_url": {
      "type": "string",
      "description": "URL do logo da empresa"
    },
    "default_bmm_template_id": {
      "type": "string",
      "description": "ID do modelo de BMM padr\u00e3o para esta empresa"
    },
    "email_faturamento": {
      "type": "string",
      "format": "email",
      "description": "Email para envio de BMM e faturamento"
    },
    "additional_services": {
      "type": "object",
      "description": "Servi\u00e7os adicionais fornecidos pela contratada (coffee break, almo\u00e7o)",
      "properties": {
        "coffee_break_morning_enabled": {
          "type": "boolean",
          "default": false
        },
        "coffee_break_morning_unit_value": {
          "type": "number",
          "default": 0
        },
        "coffee_break_afternoon_enabled": {
          "type": "boolean",
          "default": false
        },
        "coffee_break_afternoon_unit_value": {
          "type": "number",
          "default": 0
        },
        "lunch_enabled": {
          "type": "boolean",
          "default": false
        },
        "lunch_unit_value": {
          "type": "number",
          "default": 0
        }
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "object",
            "properties": {
              "street": {
                "type": "string"
              },
              "number": {
                "type": "string"
              },
              "complement": {
                "type": "string"
              },
              "neighborhood": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "zip_code": {
                "type": "string"
              }
            }
          }
        }
      },
      "description": "Unidades/Localiza\u00e7\u00f5es da empresa"
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "unit_name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "is_whatsapp": {
            "type": "boolean",
            "default": false
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "description": "Contatos da empresa"
    },
    "billing_info": {
      "type": "object",
      "properties": {
        "contact_reference": {
          "type": "string"
        },
        "contract_object": {
          "type": "string"
        }
      },
      "description": "Informa\u00e7\u00f5es de faturamento"
    },
    "fiscal_name": {
      "type": "string"
    },
    "fiscal_role": {
      "type": "string"
    },
    "contract_manager_name": {
      "type": "string"
    },
    "contract_manager_role": {
      "type": "string"
    },
    "company_courses": {
      "type": "array",
      "description": "Cursos com valores personalizados para esta empresa",
      "items": {
        "type": "object",
        "properties": {
          "course_id": {
            "type": "string"
          },
          "course_name": {
            "type": "string"
          },
          "workload_hours": {
            "type": "number"
          },
          "modality": {
            "type": "string",
            "enum": [
              "Presencial",
              "H\u00edbrido",
              "Online"
            ]
          },
          "theoretical_hours": {
            "type": "number"
          },
          "practical_hours": {
            "type": "number"
          },
          "billing_type": {
            "type": "string",
            "enum": [
              "per_student",
              "per_closed_class"
            ],
            "default": "per_student"
          },
          "specific_price": {
            "type": "number"
          },
          "class_fixed_value": {
            "type": "number"
          },
          "included_students_limit": {
            "type": "number",
            "default": 15
          }
        },
        "required": [
          "course_id",
          "course_name",
          "modality",
          "workload_hours"
        ]
      }
    },
    "company_contracts": {
      "type": "array",
      "description": "Contratos da empresa",
      "items": {
        "type": "object",
        "properties": {
          "contract_number": {
            "type": "string"
          },
          "amendment_number": {
            "type": "string"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Ativo",
              "Vencido",
              "Cancelado"
            ],
            "default": "Ativo"
          }
        },
        "required": [
          "contract_number",
          "start_date",
          "end_date"
        ]
      }
    },
    "modulos_contratados": {
      "type": "array",
      "description": "M\u00f3dulos contratados pela empresa no portal",
      "items": {
        "type": "object",
        "properties": {
          "module_key": {
            "type": "string",
            "enum": [
              "certificados",
              "treinamentos",
              "compliance_360",
              "saude_ocupacional",
              "nr01_psicossocial",
              "pgr",
              "documentos",
              "financeiro",
              "colaboradores",
              "planos_acao"
            ]
          },
          "module_name": {
            "type": "string"
          },
          "active": {
            "type": "boolean",
            "default": true
          },
          "activated_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "module_key",
          "module_name"
        ]
      }
    },
    "bmm_editor_config": {
      "type": "object",
      "description": "Configura\u00e7\u00e3o exclusiva do BMM para UNITAPAJ\u00d3S (n\u00e3o afeta outros clientes)",
      "properties": {
        "title": {
          "type": "string"
        },
        "bmm_number": {
          "type": "string"
        },
        "contract_number": {
          "type": "string"
        },
        "amendment_number": {
          "type": "string"
        },
        "contract_object": {
          "type": "string"
        },
        "fiscal_name": {
          "type": "string"
        },
        "fiscal_role": {
          "type": "string"
        },
        "contract_manager_name": {
          "type": "string"
        },
        "contract_manager_role": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "sap_config": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "codigo_material_pai": {
              "type": "string"
            },
            "presencial": {
              "type": "object",
              "properties": {
                "codigo_servico_filho": {
                  "type": "string"
                },
                "descricao": {
                  "type": "string"
                }
              }
            },
            "ead": {
              "type": "object",
              "properties": {
                "codigo_servico_filho": {
                  "type": "string"
                },
                "descricao": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "razao_social",
    "nome_fantasia",
    "cnpj"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "id": {
            "$in": "{{user.company_permissions.company_id}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor_master"
          }
        },
        {
          "id": {
            "$in": "{{user.company_permissions.company_id}}"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}