{
  "name": "FuncaoCargo",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da fun\u00e7\u00e3o/cargo (ex: Operador de Prensa, T\u00e9cnico de Seguran\u00e7a)"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da fun\u00e7\u00e3o"
    },
    "cbo": {
      "type": "string",
      "description": "C\u00f3digo CBO (Classifica\u00e7\u00e3o Brasileira de Ocupa\u00e7\u00f5es)"
    },
    "setor": {
      "type": "string",
      "description": "Setor/departamento"
    },
    "grau_risco": {
      "type": "number",
      "minimum": 1,
      "maximum": 4,
      "description": "Grau de risco (1-4)"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Operacional"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}