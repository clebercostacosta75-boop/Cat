{
  "name": "Notificar Instrutor \u2014 Turma Confirmada",
  "description": "Envia WhatsApp ao instrutor quando a turma (ClassSchedule) muda para status Confirmado.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"Confirmado\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ClassSchedule"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notificar_instrutor_turma_confirmada",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notificarInstrutorTurmaConfirmada",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notificarInstrutorTurmaConfirmada"
  }
}