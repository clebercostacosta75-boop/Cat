{
  "name": "Alertas Di\u00e1rios de Vencimento de Certificados",
  "description": "Verifica diariamente os certificados que vencem nos pr\u00f3ximos 30 dias e registra os alertas no AuditLog para que o gestor possa acionar o aluno e o RH da empresa via WhatsApp.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 11 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "alertas_di_rios_de_vencimento_de_certificados",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "alertarVencimentoCertificados",
            "args": {
              "days_ahead": 30,
              "dry_run": false
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "alertarVencimentoCertificados"
  }
}