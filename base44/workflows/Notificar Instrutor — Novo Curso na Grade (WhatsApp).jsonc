{
  "name": "Notificar Instrutor \u2014 Novo Curso na Grade (WhatsApp)",
  "description": "Envia notifica\u00e7\u00e3o autom\u00e1tica via WhatsApp ao instrutor sempre que uma turma nova \u00e9 criada com ele ou quando ele \u00e9 atribu\u00eddo/alterado em uma turma existente na grade de treinamentos.",
  "trigger": {
    "condition": "${ (.trigger.data.instructor_id != null and .trigger.data.instructor_id != \"\" and .trigger.data.instructor_id != [] and .trigger.data.instructor_id != {}) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "ClassSchedule"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notificar_instrutor_novo_curso_na_grade_whatsapp",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notificarInstrutorGradeWhatsApp",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notificarInstrutorGradeWhatsApp"
  }
}