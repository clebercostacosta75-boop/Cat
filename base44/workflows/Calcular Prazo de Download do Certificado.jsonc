{
  "name": "Calcular Prazo de Download do Certificado",
  "description": "Calcula automaticamente o download_deadline quando signed_at \u00e9 preenchido (30 dias para aluno, 45 para empresa) e bloqueia o download se o prazo expirar.",
  "trigger": {
    "condition": "${ (.trigger.data.signed_at != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Certificate"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "calcular_prazo_de_download_do_certificado",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "gerenciarPrazoDownloadCertificado",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "gerenciarPrazoDownloadCertificado"
  }
}