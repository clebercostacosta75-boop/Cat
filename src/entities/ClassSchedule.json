{
  "name": "ClassSchedule",
  "type": "object",
  "properties": {
    "training_name": {
      "type": "string",
      "description": "Nome do treinamento (curso)"
    },
    "company_name": {
      "type": "string",
      "description": "Nome da empresa"
    },
    "location": {
      "type": "string",
      "description": "Local (Ex: Tail\u00e2ndia, Bel\u00e9m)"
    },
    "students_count": {
      "type": "number",
      "description": "N\u00famero de alunos"
    },
    "status": {
      "type": "string",
      "enum": [
        "Agendado",
        "Em Andamento",
        "Conclu\u00eddo",
        "Cancelado"
      ],
      "default": "Agendado",
      "description": "Status da turma"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Data de finaliza\u00e7\u00e3o"
    },
    "specific_days": {
      "type": "string",
      "description": "Dias espec\u00edficos do treinamento"
    },
    "training_schedule": {
      "type": "string",
      "description": "Hor\u00e1rio do treinamento (Ex: 07:00 \u00e0s 12:00)"
    },
    "instructor_name": {
      "type": "string",
      "description": "Nome do instrutor"
    },
    "modality": {
      "type": "string",
      "enum": [
        "Forma\u00e7\u00e3o",
        "Peri\u00f3dico"
      ],
      "description": "Modalidade (Forma\u00e7\u00e3o ou Peri\u00f3dico)"
    },
    "category": {
      "type": "string",
      "enum": [
        "Presencial",
        "H\u00edbrido",
        "Online"
      ],
      "description": "Categoria (Presencial, H\u00edbrido ou Online)"
    },
    "duration_hours": {
      "type": "number",
      "description": "HR - Carga hor\u00e1ria (preenchido automaticamente do curso)"
    },
    "month": {
      "type": "string",
      "description": "M\u00eas (calculado automaticamente da data de in\u00edcio)"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais"
    }
  },
  "required": [
    "training_name",
    "company_name",
    "start_date"
  ]
}