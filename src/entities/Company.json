{
  "name": "Company",
  "type": "object",
  "properties": {
    "razao_social": {
      "type": "string",
      "description": "Razão Social da empresa"
    },
    "nome_fantasia": {
      "type": "string",
      "description": "Nome Fantasia"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ da empresa"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Inativo"
      ],
      "default": "Ativo",
      "description": "Status da empresa"
    },
    "logo_url": {
      "type": "string",
      "description": "URL do logo da empresa"
    },
    "default_bmm_template_id": {
      "type": "string",
      "description": "ID do modelo de BMM padrão para esta empresa"
    },
    "email_faturamento": {
      "type": "string",
      "format": "email",
      "description": "Email para envio de BMM e faturamento"
    },
    "sap_config": {
      "type": "object",
      "description": "Configuração SAP da empresa (para clientes como UNITAPAJÓS)",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Ativar preenchimento automático de campos SAP"
        },
        "codigo_material_pai": {
          "type": "string",
          "description": "Código Material (PAI) SAP - mesmo para todas as modalidades"
        },
        "presencial": {
          "type": "object",
          "properties": {
            "codigo_servico_filho": {
              "type": "string",
              "description": "Código Serviço (FILHO) SAP para modalidade Presencial"
            },
            "descricao": {
              "type": "string",
              "description": "Descrição SAP para modalidade Presencial"
            }
          }
        },
        "ead": {
          "type": "object",
          "properties": {
            "codigo_servico_filho": {
              "type": "string",
              "description": "Código Serviço (FILHO) SAP para modalidade EAD"
            },
            "descricao": {
              "type": "string",
              "description": "Descrição SAP para modalidade EAD"
            }
          }
        }
      }
    },
    "additional_services": {
      "type": "object",
      "description": "Serviços adicionais fornecidos pela contratada (coffee break, almoço)",
      "properties": {
        "coffee_break_morning_enabled": {
          "type": "boolean",
          "default": false,
          "description": "Oferece coffee break manhã"
        },
        "coffee_break_morning_unit_value": {
          "type": "number",
          "default": 0,
          "description": "Valor unitário por pessoa - coffee break manhã (R$)"
        },
        "coffee_break_afternoon_enabled": {
          "type": "boolean",
          "default": false,
          "description": "Oferece coffee break tarde"
        },
        "coffee_break_afternoon_unit_value": {
          "type": "number",
          "default": 0,
          "description": "Valor unitário por pessoa - coffee break tarde (R$)"
        },
        "lunch_enabled": {
          "type": "boolean",
          "default": false,
          "description": "Oferece almoço"
        },
        "lunch_unit_value": {
          "type": "number",
          "default": 0,
          "description": "Valor unitário por pessoa - almoço (R$)"
        }
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "object",
            "properties": {
              "street": {
                "type": "string"
              },
              "number": {
                "type": "string"
              },
              "complement": {
                "type": "string"
              },
              "neighborhood": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "zip_code": {
                "type": "string"
              }
            }
          }
        }
      },
      "description": "Unidades/Localizações da empresa"
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "unit_name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "is_whatsapp": {
            "type": "boolean",
            "default": false
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "description": "Contatos da empresa"
    },
    "billing_info": {
      "type": "object",
      "properties": {
        "contact_reference": {
          "type": "string"
        },
        "contract_object": {
          "type": "string"
        }
      },
      "description": "Informações de faturamento"
    },
    "fiscal_name": {
      "type": "string"
    },
    "fiscal_role": {
      "type": "string"
    },
    "contract_manager_name": {
      "type": "string"
    },
    "contract_manager_role": {
      "type": "string"
    },
    "company_courses": {
      "type": "array",
      "description": "Cursos com valores personalizados para esta empresa",
      "items": {
        "type": "object",
        "properties": {
          "course_id": {
            "type": "string"
          },
          "course_name": {
            "type": "string"
          },
          "workload_hours": {
            "type": "number"
          },
          "modality": {
            "type": "string",
            "enum": [
              "Presencial",
              "Híbrido",
              "Online"
            ]
          },
          "theoretical_hours": {
            "type": "number"
          },
          "practical_hours": {
            "type": "number"
          },
          "billing_type": {
            "type": "string",
            "enum": [
              "per_student",
              "per_closed_class"
            ],
            "default": "per_student"
          },
          "specific_price": {
            "type": "number"
          },
          "class_fixed_value": {
            "type": "number"
          },
          "included_students_limit": {
            "type": "number",
            "default": 15
          }
        },
        "required": [
          "course_id",
          "course_name",
          "modality",
          "workload_hours"
        ]
      }
    },
    "company_contracts": {
      "type": "array",
      "description": "Contratos da empresa",
      "items": {
        "type": "object",
        "properties": {
          "contract_number": {
            "type": "string"
          },
          "amendment_number": {
            "type": "string"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Ativo",
              "Vencido",
              "Cancelado"
            ],
            "default": "Ativo"
          }
        },
        "required": [
          "contract_number",
          "start_date",
          "end_date"
        ]
      }
    }
  },
  "required": [
    "razao_social",
    "nome_fantasia",
    "cnpj"
  ]
}