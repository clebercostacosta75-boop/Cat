{
  "name": "Company",
  "type": "object",
  "properties": {
    "razao_social": {
      "type": "string",
      "description": "Raz\u00e3o Social da empresa"
    },
    "nome_fantasia": {
      "type": "string",
      "description": "Nome Fantasia"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ da empresa"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Inativo"
      ],
      "default": "Ativo",
      "description": "Status da empresa"
    },
    "email_faturamento": {
      "type": "string",
      "format": "email",
      "description": "Email para envio de BMM e faturamento"
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome da unidade/localiza\u00e7\u00e3o"
          },
          "address": {
            "type": "object",
            "properties": {
              "street": {
                "type": "string",
                "description": "Logradouro"
              },
              "number": {
                "type": "string",
                "description": "N\u00famero"
              },
              "complement": {
                "type": "string",
                "description": "Complemento"
              },
              "neighborhood": {
                "type": "string",
                "description": "Bairro"
              },
              "city": {
                "type": "string",
                "description": "Cidade"
              },
              "state": {
                "type": "string",
                "description": "Estado"
              },
              "zip_code": {
                "type": "string",
                "description": "CEP"
              }
            }
          }
        }
      },
      "description": "Unidades/Localiza\u00e7\u00f5es da empresa"
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome do contato"
          },
          "role": {
            "type": "string",
            "description": "Cargo/Fun\u00e7\u00e3o"
          },
          "unit_name": {
            "type": "string",
            "description": "Unidade vinculada"
          },
          "phone": {
            "type": "string",
            "description": "Telefone/Celular"
          },
          "is_whatsapp": {
            "type": "boolean",
            "default": false,
            "description": "\u00c9 WhatsApp?"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email do contato"
          }
        }
      },
      "description": "Contatos da empresa"
    },
    "billing_info": {
      "type": "object",
      "properties": {
        "contact_reference": {
          "type": "string",
          "description": "Refer\u00eancia do contato para BMM"
        },
        "contract_object": {
          "type": "string",
          "description": "Objeto do contrato"
        }
      },
      "description": "Informa\u00e7\u00f5es de faturamento"
    }
  },
  "required": [
    "razao_social",
    "nome_fantasia",
    "cnpj"
  ]
}