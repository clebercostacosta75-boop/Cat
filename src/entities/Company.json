{
  "name": "Company",
  "type": "object",
  "properties": {
    "razao_social": {
      "type": "string",
      "description": "Razão Social da empresa"
    },
    "nome_fantasia": {
      "type": "string",
      "description": "Nome Fantasia"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ da empresa"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Inativo"
      ],
      "default": "Ativo",
      "description": "Status da empresa"
    },
    "email_faturamento": {
      "type": "string",
      "format": "email",
      "description": "Email para envio de BMM e faturamento"
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome da unidade/localização"
          },
          "address": {
            "type": "object",
            "properties": {
              "street": {
                "type": "string",
                "description": "Logradouro"
              },
              "number": {
                "type": "string",
                "description": "Número"
              },
              "complement": {
                "type": "string",
                "description": "Complemento"
              },
              "neighborhood": {
                "type": "string",
                "description": "Bairro"
              },
              "city": {
                "type": "string",
                "description": "Cidade"
              },
              "state": {
                "type": "string",
                "description": "Estado"
              },
              "zip_code": {
                "type": "string",
                "description": "CEP"
              }
            }
          }
        }
      },
      "description": "Unidades/Localizações da empresa"
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome do contato"
          },
          "role": {
            "type": "string",
            "description": "Cargo/Função"
          },
          "unit_name": {
            "type": "string",
            "description": "Unidade vinculada"
          },
          "phone": {
            "type": "string",
            "description": "Telefone/Celular"
          },
          "is_whatsapp": {
            "type": "boolean",
            "default": false,
            "description": "É WhatsApp?"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email do contato"
          }
        }
      },
      "description": "Contatos da empresa"
    },
    "billing_info": {
      "type": "object",
      "properties": {
        "contact_reference": {
          "type": "string",
          "description": "Referência do contato para BMM"
        },
        "contract_object": {
          "type": "string",
          "description": "Objeto do contrato"
        }
      },
      "description": "Informações de faturamento"
    },
    "company_courses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "course_id": {
            "type": "string",
            "description": "ID do curso"
          },
          "course_name": {
            "type": "string",
            "description": "Nome do curso"
          },
          "workload_hours": {
            "type": "number",
            "description": "Carga horária total"
          },
          "modality": {
            "type": "string",
            "enum": ["Presencial", "Híbrido", "Online"],
            "description": "Modalidade do curso"
          },
          "theoretical_hours": {
            "type": "number",
            "description": "Horas teóricas (EAD)"
          },
          "practical_hours": {
            "type": "number",
            "description": "Horas práticas/presenciais"
          },
          "billing_type": {
            "type": "string",
            "enum": ["per_student", "per_closed_class"],
            "default": "per_student",
            "description": "Tipo de cobrança: valor unitário por aluno ou valor por turma fechada"
          },
          "specific_price": {
            "type": "number",
            "description": "Valor específico para cobrança por aluno (billing_type=per_student)"
          },
          "class_fixed_value": {
            "type": "number",
            "description": "Valor fixo da turma fechada (billing_type=per_closed_class)"
          },
          "included_students_limit": {
            "type": "number",
            "default": 15,
            "description": "Quantidade máxima de alunos inclusos na turma fechada"
          },
          "extra_student_unit_value": {
            "type": "number",
            "description": "Valor unitário por aluno excedente (acima do limite)"
          }
        }
      },
      "description": "Cursos personalizados da empresa"
    },
    "company_contracts": {
      "type": "array",
      "description": "Contratos da empresa"
    }
  },
  "required": [
    "razao_social",
    "nome_fantasia",
    "cnpj"
  ]
}